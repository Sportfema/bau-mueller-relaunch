xt-xs font-semibold text-[#4A4641] space-y-2 mb-6 uppercase tracking-wider\">\n          <li>✓ ENplus A1 zertifizierte Qualität</li>\n          <li>✓ 15 kg Einzelsäcke oder ganze Paletten</li>\n          <li>✓ Günstige Vorbestellpreise ab Werk</li>\n        </ul>\n        <a href=\"#kontakt\" class=\"btn-pill-dark\">\n          <span>Brennstoffe anfragen</span>\n          <svg class=\"w-3.5 h-3.5 text-[#E31936]\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n            <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.5\" d=\"M14 5l7 7m0 0l-7 7m7-7H3\"/>\n          </svg>\n        </a>\n      </div>\n    </div>\n\n  </section>\n\n  <!-- CTA FOOTER SLAB -->\n  <footer id=\"kontakt\" class=\"bg-charcoal text-cream pt-20 pb-12 rounded-t-[40px]\">\n    <div class=\"max-w-[1340px] mx-auto px-6 lg:px-10 text-center\">\n      <h2 class=\"font-heading font-bold text-3xl sm:text-5xl text-[#FFFCF5] mb-6\">\n        Lassen Sie uns Ihr Vorhaben besprechen.\n      </h2>\n      <p class=\"text-muted-dark text-base max-w-xl mx-auto mb-8\">\n        Wir beraten Sie fachkundig vor Ort in Colditz, Grimma, Leipzig und Umgebung – unverbindlich und meisterlich.\n      </p>\n      <div class=\"flex items-center justify-center gap-4 flex-wrap\">\n        <a href=\"tel:+493438143336\" class=\"btn-pill-light text-base\">\n          <span>034381-43336 anrufen</span>\n          <svg class=\"w-4 h-4 text-[#1C1B1A]\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n            <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.5\" d=\"M14 5l7 7m0 0l-7 7m7-7H3\"/>\n          </svg>\n        </a>\n        <a href=\"somerville_prototype.html\" class=\"btn-pill-dark border border-white/20 text-base\">\n          <span>Zurück zur Startseite</span>\n        </a>\n      </div>\n      <p class=\"text-xs text-muted-dark mt-16 pt-8 border-t border-white/10\">\n        © 2026 Zimmerei & Baugeschäft Arthur Müller e.K. · Geithainer