          "widgetType": "html",
          "settings": {
            "html": "<!-- SOMERVILLE ARCHITECTURAL CRAFT DESIGN: NEU – Referenzen -->\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link href=\"https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Inter:wght@400;500;600&display=swap\" rel=\"stylesheet\">\n<script src=\"https://cdn.tailwindcss.com\"></script>\n<style>\nbody {\n      font-family: 'Inter', sans-serif;\n      background-color: #F8F5EE;\n      color: #1A1918;\n      -webkit-font-smoothing: antialiased;\n    }\n    h1, h2, h3, h4, .font-heading {\n      font-family: 'Plus Jakarta Sans', sans-serif;\n      letter-spacing: -0.028em;\n    }\n    .bg-cream { background-color: #F8F5EE; }\n    .bg-charcoal { background-color: #1C1B1A; }\n    .bg-charcoal-card { background-color: #262523; }\n    .text-charcoal { color: #1A1918; }\n    .text-cream { color: #FAF7F2; }\n    .text-muted-dark { color: #9C968F; }\n    .accent-red { color: #E31936; }\n\n    .btn-pill-dark {\n      background-color: #1C1B1A;\n      color: #FAF7F2;\n      border-radius: 9999px;\n      padding: 12px 26px;\n      font-size: 14px;\n      font-weight: 600;\n      display: inline-flex;\n      align-items: center;\n      gap: 10px;\n      transition: all 0.25s ease;\n    }\n    .btn-pill-dark:hover {\n      background-color: #2F2E2C;\n      transform: translateY(-1px);\n    }\n    .btn-pill-light {\n      background-color: #FAF7F2;\n      color: #1C1B1A;\n      border-radius: 9999px;\n      padding: 12px 26px;\n      font-size: 14px;\n      font-weight: 600;\n      display: inline-flex;\n      align-items: center;\n      gap: 10px;\n      transition: all 0.25s ease;\n    }\n    .btn-pill-light:hover {\n      background-color: #FFFFFF;\n      transform: translateY(-1px);\n    }\n\n    .filter-pill {\n      border-radius: 9999px;\n      padding: 8px 20px;\n      font-size: 13px;\n      font-weight: 600;\n      transition: all 0.2s ease;\n      cursor: pointer;\n    }\n    .filter-pill.active {\n      background-color: #1C1B1A;\n      color: #FAF7F2;\n    }\n    .filter-pill:not(.active) {\n      background-color: #EFEAE0;\n      color: #5C5751;\n    }\n    .filter-pill:not(.active):hover {\n      background-color: #E4DFD4;\n      color: #1A1918;\n    }\n\n    .action-circle-badge {\n      position: absolute;\n      bottom: 16px;\n      right: 16px;\n      width: 44px;\n      height: 44px;\n      background-color: #FFFFFF;\n      border-radius: 50%;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      box-shadow: 0 4px 14px rgba(0, 0, 0, 0.14);\n      transition: transform 0.3s ease, background-color 0.3s ease;\n    }\n    .group:hover .action-circle-badge {\n      transform: scale(1.1);\n      background-color: #FAF7F2;\n    }\n</style>\n\n<div class=\"somerville-container w-full bg-[#F8F5EE] text-[#1A1918] antialiased\" style=\"font-family: 'Inter', sans-serif;\">\n<!-- INTRO HEADER -->\n  <section class=\"py-20 px-6 max-w-[1340px] mx-auto border-b border-[#E8E3D8]\">\n    <span class=\"text-xs uppercase tracking-[0.2em] font-semibold text-[#E31936] block mb-3\">\n      132+ Realisierte Bauprojekte in Sachsen\n    </span>\n    <h1 class=\"font-heading font-extrabold text-4xl sm:text-6xl text-[#1A1918] leading-[1.1] max-w-4xl tracking-tight\">\n      Unsere Referenzen: Handwerkskunst in Bildern.\n    </h1>\n    <p class=\"mt-6 text-lg text-[#6E6963] max-w-2xl leading-relaxed\">\n      Vom monumentalen Kirchendachstuhl bis zur maßgefertigten Eichentreppe im Privatneubau. Erleben Sie die Vielfalt unserer Holzarbeiten, Mauerwerke und Denkmalsanierungen.\n    </p>\n\n    <!-- Filter Tabs (Somerville Pill Style) -->\n    <div class=\"flex items-center gap-3 mt-10 flex-wrap\">\n      <button class=\"filter-pill active\">Alle Gewerke</button>\n      <button class=\"filter-pill\">Zimmerei & Dachstühle</button>\n      <button class=\"filter-pill\">Treppen- & Möbelbau</button>\n      <button class=\"filter-pill\">Maurer- & Massivbau</button>\n      <button class=\"filter-pill\">Altbausanierung & Denkmal</button>\n    </div>\n  </section>\n\n  <!-- ASYMMETRIC PORTFOLIO GRID (100% REAL PHOTOS) -->\n  <section class=\"py-20 max-w-[1340px] mx-auto px-6\">\n    <div class=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8\">\n      \n      <!-- Project 1: Kirchendachstuhl Wildenhain -->\n      <div class=\"group cursor-pointer\">\n        <div class=\"relative aspect-[4/3] rounded-[24px] overflow-hidden bg-[#EAE5D9] mb-4\">\n          <img \n            src=\"https://bau-mueller.eu/wp-content/uploads/2022/04/Dachstuhl-Sanierung-Kirche-Wildenhain.jpeg\" \n            alt=\"Dachstuhlsanierung Kirche Wildenhain\" \n            class=\"w-full h-full object-cover group-hover:scale-105 transition-transform duration-700\"\n          >\n          <div class=\"action-circle-badge\">\n            <svg class=\"w-4 h-4 text-[#E31936]\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\">\n              <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M14 5l7 7m0 0l-7 7m7-7H3\"/>\n            </svg>\n          </div>\n        </div>\n        <span class=\"text-xs font-semibold text-[#E31936] uppercase tracking-wider block\">Zimmerei & Denkmal · Wildenhain</span>\n        <h3 class=\"font-heading font-bold text-xl text-[#1A1918] mt-1\">Dachstuhlsanierung Kirche Wildenhain</h3>\n        <p class=\"text-sm text-[#6E6963] mt-1\">Komplette statische Ertüchtigung des historischen Kehlbalkendachs mit Eichen-Verblattungen.</p>\n      </div>\n\n      <!-- Project 2: Wangentreppe Koltzschen -->\n      <div class=\"group cursor-pointer\">\n        <div class=\"relative aspect-[4/3] rounded-[24px] overflow-hidden bg-[#EAE5D9] mb-4\">\n          <img \n            src=\"https://bau-mueller.eu/wp-content/uploads/2022/04/Wangentreppe-viertelgewendelt-Koltzschen.jpeg\" \n            alt=\"Viertelgewendelte Holztreppe Koltzschen\" \n            class=\"w-full h-full object-cover group-hover:scale-105 transition-transform duration-700\"\n          >\n          <div class=\"action-circle-badge\">\n            <svg class=\"w-4 h-4 text-[#E31936]\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\">\n              <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M14 5l7 7m0 0l-7 7m7-7H3\"/>\n            </svg>\n          </div>\n        </div>\n        <span class=\"text-xs font-semibold text-[#E31936] uppercase tracking-wider block\">Treppenbau · Koltzschen</span>\n        <h3 class=\"font-heading font-bold text-xl text-[#1A1918] mt-1\">Viertelgewendelte Wangentreppe</h3>\n        <p class=\"text-sm text-[#6E6963] mt-1\">Maßgefertigte Hartholzstufen in Esche massiv, passgenau eingepasst in modernisierten Altbau.</p>\n      </div>\n\n      <!-- Project 3: Sichtmauerwerk Röhrsdorf -->\n      <div class=\"group cursor-pointer\">\n        <div class=\"relative aspect-[4/3] rounded-[24px] overflow-hidden bg-[#EAE5D9] mb-4\">\n          <img \n            src=\"https://bau-mueller.eu/wp-content/uploads/2022/04/Sichtmauerwerk-Röhrsdorf.jpeg\" \n            alt=\"Sichtmauerwerk Röhrsdorf\" \n            class=\"w-full h-full object-cover group-hover:scale-105 transition-transform duration-700\"\n          >\n          <div class=\"action-circle-badge\">\n            <svg class=\"w-4 h-4 text-[#E31936]\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\">\n              <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M14 5l7 7m0 0l-7 7m7-7H3\"/>\n            </svg>\n          </div>\n        </div>\n        <span class=\"text-xs font-semibold text-[#E31936] uppercase tracking-wider block\">Maurerarbeiten · Röhrsdorf</span>\n        <h3 class=\"font-heading font-bold text-xl text-[#1A1918] mt-1\">Sichtmauerwerk & Fassade</h3>\n        <p class=\"text-sm text-[#6E6963] mt-1\">Handwerklich verfugtes Klinkermauerwerk mit Natursteinelementen für dauerhafte Witterungsbeständigkeit.</p>\n      </div>\n\n      <!-- Project 4: Kirchturmsanierung Zschirla -->\n      <div class=\"group cursor-pointer\">\n        <div class=\"relative aspect-[4/3] rounded-[24px] overflow-hidden bg-[#EAE5D9] mb-4\">\n          <img \n            src=\"https://bau-mueller.eu/wp-content/uploads/2022/04/Putzsanierung-Kirchturm-Zschirla.jpeg\" \n            alt=\"Putzsanierung Kirchturm Zschirla\" \n            class=\"w-full h-full object-cover group-hover:scale-105 transition-transform duration-700\"\n          >\n          <div class=\"action-circle-badge\">\n            <svg class=\"w-4 h-4 text-[#E31936]\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\">\n              <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M14 5l7 7m0 0l-7 7m7-7H3\"/>\n            </svg>\n          </div>\n        </div>\n        <span class=\"text-xs font-semibold text-[#E31936] uppercase tracking-wider block\">Denkmalpflege · Zschirla</span>\n        <h3 class=\"font-heading font-bold text-xl text-[#1A1918] mt-1\">Putz- & Turmsanierung Kirchturm</h3>\n        <p class=\"text-sm text-[#6E6963] mt-1\">Denkmalgerechte Erneuerung des Außenputzes in traditioneller Kalkputz-Technik in schwindelnder Höhe.</p>\n      </div>\n\n      <!-- Project 5: Wendeltreppe Leipzig -->\n      <div class=\"group cursor-pointer\">\n        <div class=\"relative aspect-[4/3] rounded-[24px] overflow-hidden bg-[#EAE5D9] mb-4\">\n          <img \n            src=\"https://bau-mueller.eu/wp-content/uploads/2022/04/Bild-7-1.jpeg\" \n            alt=\"Massivholz-Wendeltreppe Leipzig\" \n            class=\"w-full h-full object-cover group-hover:scale-105 transition-transform duration-700\"\n          >\n          <div class=\"action-circle-badge\">\n            <svg class=\"w-4 h-4 text-[#E31936]\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\">\n              <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M14 5l7 7m0 0l-7 7m7-7H3\"/>\n            </svg>\n          </div>\n        </div>\n        <span class=\"text-xs font-semibold text-[#E31936] uppercase tracking-wider block\">Treppenbau · Leipzig</span>\n        <h3 class=\"font-heading font-bold text-xl text-[#1A1918] mt-1\">Moderne Holz-Wendeltreppe</h3>\n        <p class=\"text-sm text-[#6E6963] mt-1\">Filigrane Staketenführung und massive Eichentritte für anspruchsvolles architektonisches Wohnen.</p>\n      </div>\n\n      <!-- Project 6: Dachreiter Neubau Leipzig -->\n      <div class=\"group cursor-pointer\">\n        <div class=\"relative aspect-[4/3] rounded-[24px] overflow-hidden bg-[#EAE5D9] mb-4\">\n          <img \n            src=\"https://bau-mueller.eu/wp-content/uploads/2022/04/Dachreiter-Neubau-Leipzig.jpeg\" \n            alt=\"Dachreiter Neubau Leipzig\" \n            class=\"w-full h-full object-cover group-hover:scale-105 transition-transform duration-700\"\n          >\n          <div class=\"action-circle-badge\">\n            <svg class=\"w-4 h-4 text-[#E31936]\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\">\n              <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M14 5l7 7m0 0l-7 7m7-7H3\"/>\n            </svg>\n          </div>\n        </div>\n        <span class=\"text-xs font-semibold text-[#E31936] uppercase tracking-wider block\">Zimmerei · Leipzig</span>\n        <h3 class=\"font-heading font-bold text-xl text-[#1A1918] mt-1\">Dachreiter & Sonderkonstruktion</h3>\n        <p class=\"text-sm text-[#6E6963] mt-1\">Aufwendig abgebundener Turmaufbau mit millimetergenauer Werkstatt-Passung vor dem Einhub per Autokran.</p>\n      </div>\n\n    </div>\n  </section>\n\n  <!-- FOOTER -->\n</div>\n"
          }
        }
      ]
    }
  ]
}