\n    <!-- Close Button -->\n    <button id=\"feedback-popup-close\" class=\"absolute top-4 right-4 w-7 h-7 rounded-full bg-white/10 hover:bg-white/20 flex items-center justify-center text-white/70 hover:text-white transition-colors focus:outline-none\" aria-label=\"Feedback-Fenster schließen\">\n      <svg class=\"w-3.5 h-3.5\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n        <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M6 18L18 6M6 6l12 12\"/>\n      </svg>\n    </button>\n\n    <!-- Initial State -->\n    <div id=\"voting-initial-state\">\n      <div class=\"flex items-center gap-2 mb-2\">\n        <span class=\"w-2 h-2 rounded-full bg-[#E31936] animate-pulse\"></span>\n        <span class=\"text-[11px] font-semibold tracking-wider uppercase text-[#E31936]\">Neuer Webauftritt</span>\n      </div>\n      <h3 class=\"font-heading font-bold text-lg text-white mb-1.5 leading-snug\">\n        Wie gefällt Ihnen unsere neue Website?\n      </h3>\n      <p class=\"text-xs text-[#A39E93] mb-4 leading-relaxed\">\n        Ihre Meinung zählt: Wie gefällt Ihnen das neue Design unseres Meisterbetriebs?\n      </p>\n\n      <div class=\"grid grid-cols-3 gap-2\">\n        <button class=\"vote-btn py-2.5 px-2 rounded-xl bg-white/10 hover:bg-[#E31936] text-white text-xs font-semibold flex flex-col items-center gap-1 transition-all\" data-vote=\"super\">\n          <span class=\"text-base\">😍</span>\n          <span>Begeistert</span>\n        </button>\n        <button class=\"vote-btn py-2.5 px-2 rounded-xl bg-white/10 hover:bg-white/20 text-white text-xs font-semibold flex flex-col items-center gap-1 transition-all\" data-vote=\"gut\">\n          <span class=\"text-base\">👍</span>\n          <span>Sehr gut</span>\n        </button>\n        <button class=\"vote-btn py-2.5 px-2 rounded-xl bg-white/10 hover:bg-white/20 text-white text-xs font-semibold flex flex-col items-center gap-1 transition-all\" data-vote=\"feedback\">\n          <span class=\"text-base\">💬</span>\n          <span>Geht so</span>\n        </button>\n      </div>\n    </div>\n\n    <!-- Thank You State -->\n    <div id=\"voting-thankyou-state\" class=\"hidden py-4 text-center\">\n      <span class=\"text-3xl block mb-2\">🪵✨</span>\n      <h4 class=\"font-heading font-bold text-base text-white mb-1\">Vielen Dank für Ihre Stimme!</h4>\n      <p class=\"text-xs text-[#A39E93]\">Ihr Feedback hilft uns, den Auftritt unseres Meisterbetriebs stetig zu verfeinern.</p>\n    </div>\n\n  </aside>\n\n  <script>\n    // FEEDBACK VOTING POPUP LOGIC (Trigger nach 8 Sekunden & Speicherung auf Server)\n    (function() {\n      var popup = document.getElementById('feedback-voting-popup');\n      if (!popup) return;\n      \n      if (localStorage.getItem('mueller_website_voted') || sessionStorage.getItem('mueller_popup_dismissed')) {\n        return;\n      }\n\n      var closeBtn = document.getElementById('feedback-popup-close');\n      var initialState = document.getElementById('voting-initial-state');\n      var thankYouState = document.getElementById('voting-thankyou-state');\n      var voteBtns = document.querySelectorAll('.vote-btn');\n\n      function showPopup() {\n        popup.classList.remove('translate-y-20', 'opacity-0', 'pointer-events-none');\n        popup.classList.add('translate-y-0', 'opacity-100', 'pointer-events-auto');\n      }\n\n      function hidePopup() {\n        popup.classList.remove('translate-y-0', 'opacity-100', 'pointer-events-auto');\n        popup.classList.add('translate-y-20', 'opacity-0', 'pointer-events-none');\n      }\n\n      setTimeout(showPopup, 8000);\n\n      if (closeBtn) {\n        closeBtn.addEventListener('click', function() {\n          hidePopup();\n          sessionStorage.setItem('mueller_popup_dismissed', 'true');\n        });\n      }\n\n      voteBtns.forEach(function(btn) {\n        btn.addEventListener('click', function() {\n          var vote = btn.getAttribute('data-vote');\n          localStorage.setItem('mueller_website_voted', vote);\n          \n          try {\n            fetch('/wp-content/vote_collector.php', {\n              method: 'POST',\n              headers: { 'Content-Type': 'application/json' },\n              body: JSON.stringify({\n                vote: vote,\n                url: window.location.pathname\n              })\n            }).catch(function(e) { console.log('Vote logging error:', e); });\n          } catch(e) {}\n          \n          if (initialState && thankYouState) {\n            initialState.classList.add('hidden');\n            thankYouState.classList.remove('hidden');\n          }\n          \n          setTimeout(hidePopup, 3000);\n        });\n      });\n    })();\n\n    // SCHNELLANFRAGE-FORMULAR LOGIC\n    function submitInquiryForm(form) {\n      var statusBox = document.getElementById('inquiry-form-status');\n      var formData = new FormData(form);\n      var name = formData.get('name') || '';\n      var phone = formData.get('phone') || '';\n      var email = formData.get('email') || '';\n      var gewerk = formData.get('gewerk') || '';\n      var msg = formData.get('message') || '';\n\n      if (statusBox) {\n        statusBox.className = 'text-xs py-3 px-4 rounded-xl bg-emerald-900/60 border border-emerald-500 text-emerald-100 block mb-4';\n        statusBox.innerHTML = '<strong>Vielen Dank, ' + name + '!</strong> Ihre Anfrage zum Bereich <em>' + gewerk + '</em> wurde aufgenommen. Meister Tobias Müller meldet sich in Kürze unter ' + phone + ' bei Ihnen.';\n      }\n      form.reset();\n    }\n  </script>\n</div>\n"
          }
        }
      ]
    }
  ]
