ackground-color: #FFFFFF;\n      border-radius: 50%;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      box-shadow: 0 4px 14px rgba(0, 0, 0, 0.14);\n      transition: transform 0.3s ease, background-color 0.3s ease;\n    }\n    .group:hover .action-circle-badge {\n      transform: scale(1.1);\n      background-color: #FAF7F2;\n    }\n    \n    .editorial-link-hover {\n      background-image: linear-gradient(currentColor, currentColor);\n      background-position: 0% 100%;\n      background-repeat: no-repeat;\n      background-size: 0% 2px;\n      transition: background-size .3s ease;\n    }\n    .group:hover .editorial-link-hover {\n      background-size: 100% 2px;\n    }\n</style>\n\n<div class=\"somerville-container w-full bg-[#F8F5EE] text-[#1A1918] antialiased\" style=\"font-family: 'Inter', sans-serif;\">\n</div>\n\n      <div class=\"text-center\">\n        <a href=\"somerville_prototype.html\" class=\"inline-block\">\n          <span class=\"block font-heading font-extrabold text-xl tracking-tight text-[#1A1918] uppercase\">\n            Arthur Müller\n          </span>\n          <span class=\"block text-[9px] tracking-[0.25em] uppercase text-[#7A756E] font-medium\">\n            Seit 1920 · Colditz\n          </span>\n        </a>\n      </div>\n\n      <div class=\"flex items-center gap-4\">\n        <a href=\"tel:03438143370\" class=\"hidden sm:inline-block text-xs font-semibold text-[#4A4641]\">\n          034381 43370\n        </a>\n        <a href=\"#kontakt\" class=\"btn-pill-dark\">\n          <span>Projekt anfragen</span>\n          <svg class=\"w-3.5 h-3.5 text-[#E31936]\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n            <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.5\" d=\"M14 5l7 7m0 0l-7 7m7-7H3\"/>\n          </svg>\n        </a>\n      </div>\n    </div>\n  </header>\n\n  <!-- HERO SECTION: LEISTUNGEN HUB -->\n  <section class=\"py-20 px-6 max-w-[1340px] mx-auto border-b border-[#E8E3D8]\">\n    <span class=\"text-xs uppercase tracking-[0.2em] font-semibold text-[#E31936] block mb-3\">\n      Gewerkeübergreifend · Alles aus einer Hand\n    </span>\n    <h1 class=\"font-heading font-extrabold text-4xl sm:text-6xl text-[#1A1918] leading-[1.1] max-w-4xl tracking-tight\">\n      Handwerkliche Meisterschaft vom Holzbau bis zum Massivbau.\n    </h1>\n    <p class=\"mt-6 text-lg text-[#6E6963] max-w-2xl leading-relaxed\">\n      Als kombinierte Zimmerei und Baugeschäft vereinen wir Planung, computergestützten Abbund, individuellen Treppenbau, Massivbau und nachhaltige Reststoffverwertung.\n    </p>\n  </section>\n\n  <!-- 5 GROSSE GEWERKE-KARTEN (SOMERVILLE STYLE: ECHTE BILDER) -->\n  <section class=\"py-20 max-w-[1340px] mx-auto px-6 space-y-16\">\n    \n    <!-- 1. Zimmerei & Holzbau -->\n    <div class=\"grid grid-cols-1 lg:grid-cols-12 gap-10 items-center\">\n      <div class=\"lg:col-span-6\">\n        <div class=\"relative aspect-[16/10] rounded-[28px] overflow-hidden bg-[#EAE5D9] group\">\n          <img \n            src=\"https://bau-mueller.eu/wp-content/uploads/2022/04/Dachstuhl-Sanierung-Kirche-Wildenhain.jpeg\" \n            alt=\"Zimmerei & Dachstühle\" \n            class=\"w-full h-full object-cover group-hover:scale-105 transition-transform duration-700\"\n          >\n          <div class=\"action-circle-badge\">\n            <svg class=\"w-4 h-4 text-[#E31936]\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\">\n              <line x1=\"12\" y1=\"5\" x2=\"12\" y2=\"19\"></line>\n              <line x1=\"5\" y1=\"12\" x2=\"19\" y2=\"12\"></line>\n            </svg>\n          </div>\n        </div>\n      </div>\n      <div class=\"lg:col-span-6 lg:pl-6\">\n        <span class=\"text-xs font-semibold tracking-wider text-[#E31936] uppercase block mb-2\">Gewerk 01</span>\n        <h2 class=\"font-heading font-bold text-3xl text-[#1A1918] mb-4\">Zimmerei & konstruktiver Holzbau</h2>\n        <p class=\"text-[#6E6963] text-base leading-relaxed mb-4\">\n          Traditionelle und moderne Dachstühle, Sichtdachstühle, Carports, Gauben, Vordächer und gewerbliche Hallenkonstruktionen. Durch den eigenen Abbund in Colditz montieren wir zügig, passgenau und wetterunabhängig vorbereitet.\n        </p>\n        <ul class=\"text-xs font-semibold text-[#4A4641] space-y-2 mb-6 uppercase tracking-wider\">\n          <li>✓ Millimetergenauer Werkstattabbund</li>\n          <li>✓ Sattel-, Walm- und Mansarddächer</li>\n          <li>✓ Carports & Holzfassaden</li>\n        </ul>\n        <a href=\"#kontakt\" class=\"btn-pill-dark\">\n          <span>Dachstuhl anfragen</span>\n          <svg class=\"w-3.5 h-3.5 text-[#E31936]\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n            <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.5\" d=\"M14 5l7 7m0 0l-7 7m7-7H3\"/>\n          </svg>\n        </a>\n      </div>\n    </div>\n\n    <!-- 2. Treppen- & Möbelbau -->\n    <div class=\"grid grid-cols-1 lg:grid-cols-12 gap-10 items-center\">\n      <div class=\"lg:col-span-6 lg:order-2\">\n        <div class=\"relative aspect-[16/10] rounded-[28px] overflow-hidden bg-[#EAE5D9] group\">\n          <img \n            src=\"https://bau-mueller.eu/wp-content/uploads/2022/04/Wangentreppe-viertelgewendelt-Koltzschen.jpeg\" \n            alt=\"Treppenbau & Möbelbau\" \n            class=\"w-full h-full object-cover group-hover:scale-105 transition-transform duration-700\"\n          >\n          <div class=\"action-circle-badge\">\n            <svg class=\"w-4 h-4 text-[#E31936]\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\">\n              <line x1=\"12\" y1=\"5\" x2=\"12\" y2=\"19\"></line>\n              <line x1=\"5\" y1=\"12\" x2=\"19\" y2=\"12\"></line>\n            </svg>\n          </div>\n        </div>\n      </div>\n      <div class=\"lg:col-span-6 lg:order-1 lg:pr-6\">\n        <span class=\"text-xs font-semibold tracking-wider text-[#E31936] uppercase block mb-2\">Gewerk 02</span>\n        <h2 class=\"font-heading font-bold text-3xl text-[#1A1918] mb-4\">Treppen- & individueller Möbelbau</h2>\n        <p class=\"text-[#6E6963] text-base leading-relaxed mb-4\">\n          Maßgefertigte Massivholztreppen verleihen Wohnräumen eine unvergleichliche Wärme. Wir fertigen gewendelte Wangentreppen, geradläufige Treppenanlagen, Geländer und passgenaue Möbel aus heimischer Eiche, Buche und Esche.\n        </p>\n        <ul class=\"text-xs font-semibold text-[#4A4641] space-y-2 mb-6 uppercase tracking-wider\">\n          <li>✓ Gewendelte & gerade Massivholztreppen</li>\n          <li>✓ Individuelle Geländer & Staketen</li>\n          <li>✓ Passgenauer Innenausbau nach Maß</li>\n        </ul>\n        <a href=\"#kontakt\" class=\"btn-pill-dark\">\n          <span>Treppenbau anfragen</span>\n          <svg class=\"w-3.5 h-3.5 text-[#E31936]\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n            <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.5\" d=\"M14 5l7 7m0 0l-7 7m7-7H3\"/>\n          </svg>\n        </a>\n      </div>\n    </div>\n\n    <!-- 3. Sägewerk & Lohnschnitt (Echtes Foto start4.jpg) -->\n    <div class=\"grid grid-cols-1 lg:grid-cols-12 gap-10 items-center\">\n      <div class=\"lg:col-span-6\">\n        <div class=\"relative aspect-[16/10] rounded-[28px] overflow-hidden bg-[#EAE5D9] group\">\n          <img \n            src=\"https://bau-mueller.eu/wp-content/uploads/2022/02/start4-768x1151.jpg\" \n            alt=\"Sägewerk und Lohnschnitt Arthur Müller\" \n            class=\"w-full h-full object-cover group-hover:scale-105 transition-transform duration-700\"\n          >\n          <div class=\"action-circle-badge\">\n            <svg class=\"w-4 h-4 text-[#E31936]\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\">\n              <line x1=\"12\" y1=\"5\" x2=\"12\" y2=\"19\"></line>\n              <line x1=\"5\" y1=\"12\" x2=\"19\" y2=\"12\"></line>\n            </svg>\n          </div>\n        </div>\n      </div>\n      <div class=\"lg:col-span-6 lg:pl-6\">\n        <span class=\"text-xs font-semibold tracking-wider text-[#E31936] uppercase block mb-2\">Kapazität 03</span>\n        <h2 class=\"font-heading font-bold text-3xl text-[#1A1918] mb-4\">Eigenes Sägewerk & Lohnschnitt</h2>\n        <p class=\"text-[#6E6963] text-base leading-relaxed mb-4\">\n          Unser neues Sägewerk verarbeitet Stämme aller Holzarten bis zu 80 cm Durchmesser und 9 m Länge. Wir sägen Kanthölzer, Bohlen, Bretter, Latten und Spezialschnitte für private Waldbesitzer, Bauherren und Handwerksbetriebe.\n        </p>\n        <ul class=\"text-xs font-semibold text-[#4A4641] space-y-2 mb-6 uppercase tracking-wider\">\n          <li>✓ Stammdurchmesser bis 80 cm, Länge bis 9 m</li>\n          <li>✓ Lohnschnitt nach individueller Schnittliste</li>\n          <li>✓ Flexible Sondermaße während der Bearbeitung</li>\n        </ul>\n        <a href=\"#kontakt\" class=\"btn-pill-dark\">\n          <span>Lohnschnitt anfragen</span>\n          <svg class=\"w-3.5 h-3.5 text-[#E31936]\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n            <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.5\" d=\"M14 5l7 7m0 0l-7 7m7-7H3\"/>\n          </svg>\n        </a>\n      </div>\n    </div>\n\n    <!-- 4. Maurer- & Betonarbeiten -->\n    <div class=\"grid grid-cols-1 lg:grid-cols-12 gap-10 items-center\">\n      <div class=\"lg:col-span-6 lg:order-2\">\n        <div class=\"relative aspect-[16/10] rounded-[28px] overflow-hidden bg-[#EAE5D9] group\">\n          <img \n            src=\"https://bau-mueller.eu/wp-content/uploads/2022/04/Sichtmauerwerk-Röhrsdorf.jpeg\" \n            alt=\"Maurer- & Betonarbeiten\" \n            class=\"w-full h-full object-cover group-hover:scale-105 transition-transform duration-700\"\n          >\n          <div class=\"action-circle-badge\">\n            <svg class=\"w-4 h-4 text-[#E31936]\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\">\n              <line x1=\"12\" y1=\"5\" x2=\"12\" y2=\"19\"></line>\n              <line x1=\"5\" y1=\"12\" x2=\"19\" y2=\"12\"></line>\n            </svg>\n          </div>\n        </div>\n      </div>\n      <div class=\"lg:col-span-6 lg:order-1 lg:pr-6\">\n        <span class=\"text-xs font-semibold tracking-wider text-[#E31936] uppercase block mb-2\">Gewerk 04</span>\n        <h2 class=\"font-heading font-bold text-3xl text-[#1A1918] mb-4\">Maurer-, Beton- & Massivbauarbeiten</h2>\n        <p class=\"text-[#6E6963] text-base leading-relaxed mb-4\">\n          Das feste Fundament für Ihr Bauwerk. Wir gießen Bodenplatten, mauern tragende Wände, führen Klinker- und Natursteinarbeiten aus und sanieren historische Kirchenmauern und Altbaufassaden nach Denkmalschutzstandards.\n        </p>\n        <ul class=\"text-xs font-semibold text-[#4A4641] space-y-2 mb-6 uppercase tracking-wider\">\n          <li>✓ Fundamente & Stahlbeton-Bodenplatten</li>\n          <li>✓ Sichtmauerwerk & Klinkerfassaden</li>\n          <li>✓ Denkmalgerechte Putz- und Steinsanierung</li>\n        </ul>\n        <a href=\"#kontakt\" class=\"btn-pill-dark\">\n          <span>Massivbau anfragen</span>\n          <svg class=\"w-3.5 h-3.5 text-[#E31936]\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n            <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.5\" d=\"M14 5l7 7m0 0l-7 7m7-7H3\"/>\n          </svg>\n        </a>\n      </div>\n    </div>\n\n    <!-- 5. Pellets & Holzbriketts (Kreislauf) -->\n    <div class=\"grid grid-cols-1 lg:grid-cols-12 gap-10 items-center\">\n      <div class=\"lg:col-span-6\">\n        <div class=\"relative aspect-[16/10] rounded-[28px] overflow-hidden bg-[#EAE5D9] group\">\n          <img \n            src=\"https://bau-mueller.eu/wp-content/uploads/2022/02/start3-768x513.jpg\" \n            alt=\"Holzreste werden zu Brennstoffen veredelt\" \n            class=\"w-full h-full object-cover group-hover:scale-105 transition-transform duration-700\"\n          >\n          <div class=\"action-circle-badge\">\n            <svg class=\"w-4 h-4 text-[#E31936]\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\">\n              <line x1=\"12\" y1=\"5\" x2=\"12\" y2=\"19\"></line>\n              <line x1=\"5\" y1=\"12\" x2=\"19\" y2=\"12\"></line>\n            </svg>\n          </div>\n        </div>\n      </div>\n      <div class=\"lg:col-span-6 lg:pl-6\">\n        <span class=\"text-xs font-semibold tracking-wider text-[#E31936] uppercase block mb-2\">Nachhaltigkeit 05</span>\n        <h2 class=\"font-heading font-bold text-3xl text-[#1A1918] mb-4\">Pellets & Holzbriketts ab Werk Colditz</h2>\n        <p class=\"text-[#6E6963] text-base leading-relaxed mb-4\">\n          100 % regionaler Kreislauf. Späne und Resthölzer aus unserer Werkstatt und dem Sägewerk werden zu hochkalorischen, sauberen ENplus A1 Pellets und Kaminbriketts gepresst. Abholung direkt ab Werk oder bequeme Palettenlieferung.\n        </p>\n        <ul class=\"text-xs font-semibold text-[#4A4641] space-y-2 mb-6 uppercase tracking-wider\">\n          <li>✓ ENplus A1 zertifizierte Qualität</li>\n          <li>✓ 15 kg Einzelsäcke oder ganze Paletten</li>\n          <li>✓ Günstige Vorbestellpreise ab Werk</li>\n        </ul>\n        <a href=\"#kontakt\" class=\"btn-pill-dark\">\n          <span>Brennstoffe anfragen</span>\n          <svg class=\"w-3.5 h-3.5 text-[#E31936]\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n            <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.5\" d=\"M14 5l7 7m0 0l-7 7m7-7H3\"/>\n          </svg>\n        </a>\n      </div>\n    </div>\n\n  </section>\n\n  <!-- CTA FOOTER SLAB -->\n</div>\n"
  },
