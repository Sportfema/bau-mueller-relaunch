          "elType": "widget",
          "widgetType": "html",
          "settings": {
            "html": "<!-- SOMERVILLE ARCHITECTURAL CRAFT DESIGN: NEU – Aktuelles -->\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link href=\"https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Inter:wght@400;500;600&display=swap\" rel=\"stylesheet\">\n<script src=\"https://cdn.tailwindcss.com\"></script>\n<style>\nbody {\n      background-color: #F8F5EE;\n      color: #1A1918;\n      font-family: 'Inter', sans-serif;\n    }\n    .font-heading {\n      font-family: 'Plus Jakarta Sans', sans-serif;\n    }\n    .btn-pill-dark {\n      display: inline-flex;\n      align-items: center;\n      gap: 0.75rem;\n      padding: 0.875rem 1.75rem;\n      border-radius: 9999px;\n      background-color: #1C1B1A;\n      color: #F8F5EE;\n      font-size: 0.875rem;\n      font-weight: 600;\n      transition: all 0.25s ease;\n    }\n    .btn-pill-dark:hover {\n      background-color: #2D2A26;\n      transform: translateY(-1px);\n    }\n    .btn-pill-light {\n      display: inline-flex;\n      align-items: center;\n      gap: 0.75rem;\n      padding: 0.875rem 1.75rem;\n      border-radius: 9999px;\n      background-color: #F8F5EE;\n      color: #1C1B1A;\n      font-size: 0.875rem;\n      font-weight: 600;\n      transition: all 0.25s ease;\n    }\n    .btn-pill-light:hover {\n      background-color: #FFFFFF;\n      transform: translateY(-1px);\n    }\n    .filter-pill {\n      display: inline-flex;\n      align-items: center;\n      padding: 0.625rem 1.25rem;\n      border-radius: 9999px;\n      font-size: 0.875rem;\n      font-weight: 600;\n      cursor: pointer;\n      transition: all 0.2s ease;\n      border: 1px solid rgba(26, 25, 24, 0.12);\n      background-color: transparent;\n      color: #4A4641;\n    }\n    .filter-pill:hover {\n      border-color: #1A1918;\n      color: #1A1918;\n    }\n    .filter-pill.active {\n      background-color: #1C1B1A;\n      border-color: #1C1B1A;\n      color: #F8F5EE;\n    }\n</style>\n\n<div class=\"somerville-container w-full bg-[#F8F5EE] text-[#1A1918] antialiased\" style=\"font-family: 'Inter', sans-serif;\">\n<!-- TOP HEADER (MINIMALIST, ARCHITECTURAL SOMERVILLE) -->\n  <header class=\"sticky top-0 z-50 bg-[#F8F5EE]/95 backdrop-blur-md border-b border-[#E8E3D8] transition-all\">\n    <div class=\"max-w-[1400px] mx-auto px-4 sm:px-6 py-4 flex items-center justify-between\">\n      \n      <!-- Left: Mobile Menu Toggle Button & Desktop Nav -->\n      <div class=\"flex items-center gap-6 sm:gap-8\">\n        <button id=\"menu-toggle-btn\" class=\"flex items-center gap-2.5 text-xs font-semibold tracking-wider uppercase text-[#1A1918] hover:text-[#E31936] transition-colors focus:outline-none\" aria-label=\"Menü öffnen\">\n          <span class=\"w-5 flex flex-col gap-1\">\n            <span class=\"block w-5 h-0.5 bg-current transition-all\"></span>\n            <span class=\"block w-3.5 h-0.5 bg-current transition-all\"></span>\n          </span>\n          <span class=\"inline\">Menü</span>\n        </button>\n        <nav class=\"hidden lg:flex items-center gap-7 text-sm font-medium text-[#4A4641]\">\n          <a href=\"/leistungen/\" class=\"hover:text-[#1A1918] transition-colors\">Leistungen</a>\n          <a href=\"/projects/\" class=\"hover:text-[#1A1918] transition-colors\">Referenzen</a>\n          <a href=\"/aktuelles/\" class=\"text-[#E31936] font-semibold\">Aktuelles</a>\n          <a href=\"/about/\" class=\"hover:text-[#1A1918] transition-colors\">Über uns</a>\n        </nav>\n      </div>\n\n      <!-- Center: Architectural Brand Identity -->\n      <div class=\"text-center\">\n        <a href=\"/\" class=\"inline-block\">\n          <span class=\"block font-heading font-extrabold text-lg sm:text-xl md:text-2xl tracking-tight text-[#1A1918] uppercase\">\n            Arthur Müller\n          </span>\n          <span class=\"block text-[9px] sm:text-[10px] tracking-[0.25em] uppercase text-[#7A756E] font-medium mt-0.5\">\n            Zimmerei & Baugeschäft · Seit 1920\n          </span>\n        </a>\n      </div>\n\n      <!-- Right: Direct Phone CTA & Project Button -->\n      <div class=\"flex items-center gap-3 sm:gap-4\">\n        <a href=\"tel:+493438143336\" class=\"hidden sm:inline-block text-xs font-semibold text-[#4A4641] hover:text-[#1A1918] transition-colors\">\n          034381 43336\n        </a>\n        <a href=\"#kontakt\" class=\"btn-pill-dark text-xs sm:text-sm\">\n          <span>Projekt anfragen</span>\n          <svg class=\"w-3.5 h-3.5 text-[#E31936]\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n            <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.5\" d=\"M14 5l7 7m0 0l-7 7m7-7H3\"/>\n          </svg>\n        </a>\n      </div>\n    </div>\n  </header>\n\n  <!-- MOBILE NAVIGATION DRAWER -->\n  <div id=\"mobile-menu-drawer\" class=\"fixed inset-0 z-[100] transition-opacity duration-300 opacity-0 pointer-events-none\" aria-hidden=\"true\">\n    <div id=\"mobile-menu-backdrop\" class=\"absolute inset-0 bg-[#1C1B1A]/80 backdrop-blur-md\"></div>\n    <div id=\"mobile-menu-panel\" class=\"absolute top-0 left-0 bottom-0 w-full max-w-sm sm:max-w-md bg-[#1C1B1A] text-[#F8F5EE] shadow-2xl flex flex-col justify-between p-6 sm:p-8 transform -translate-x-full transition-transform duration-300 ease-out border-r border-white/10 overflow-y-auto\">\n      <div>\n        <div class=\"flex items-center justify-between pb-6 border-b border-white/10\">\n          <div>\n            <span class=\"block font-heading font-extrabold text-lg tracking-tight uppercase text-white\">\n              Arthur Müller\n            </span>\n            <span class=\"block text-[10px] tracking-[0.2em] uppercase text-[#A39E93] mt-0.5 font-medium\">\n              Zimmerei & Baugeschäft · 1920\n            </span>\n          </div>\n          <button id=\"mobile-menu-close\" class=\"w-10 h-10 rounded-full bg-white/10 hover:bg-white/20 flex items-center justify-center text-white transition-colors focus:outline-none\" aria-label=\"Menü schließen\">\n            <svg class=\"w-5 h-5\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n              <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M6 18L18 6M6 6l12 12\"/>\n            </svg>\n          </button>\n        </div>\n\n        <nav class=\"mt-6 flex flex-col gap-2\">\n          <a href=\"/\" class=\"mobile-nav-link text-base sm:text-lg font-semibold text-white/90 hover:text-white py-2.5 flex items-center justify-between border-b border-white/5 transition-colors\">\n            <span>Startseite</span>\n            <span class=\"text-xs text-[#E31936]\">01</span>\n          </a>\n          <a href=\"/leistungen/\" class=\"mobile-nav-link text-base sm:text-lg font-semibold text-white/90 hover:text-white py-2.5 flex items-center justify-between border-b border-white/5 transition-colors\">\n            <span>Leistungen & Handwerk</span>\n            <span class=\"text-xs text-[#E31936]\">02</span>\n          </a>\n          <a href=\"/projects/\" class=\"mobile-nav-link text-base sm:text-lg font-semibold text-white/90 hover:text-white py-2.5 flex items-center justify-between border-b border-white/5 transition-colors\">\n            <span>Referenzen & Bauten</span>\n            <span class=\"text-xs text-[#E31936]\">03</span>\n          </a>\n          <a href=\"/aktuelles/\" class=\"mobile-nav-link text-base sm:text-lg font-semibold text-white py-2.5 flex items-center justify-between border-b border-white/5 transition-colors\">\n            <span class=\"text-[#E31936]\">Aktuelles & Magazin</span>\n            <span class=\"text-xs text-[#E31936]\">04</span>\n          </a>\n          <a href=\"/about/\" class=\"mobile-nav-link text-base sm:text-lg font-semibold text-white/90 hover:text-white py-2.5 flex items-center justify-between border-b border-white/5 transition-colors\">\n            <span>Über uns (4. Generation)</span>\n            <span class=\"text-xs text-[#E31936]\">05</span>\n          </a>\n        </nav>\n      </div>\n\n      <div class=\"pt-8 border-t border-white/10 mt-8\">\n        <a href=\"tel:+493438143336\" class=\"btn-pill-light w-full justify-center mb-4 text-sm\">\n          <span>034381-43336 anrufen</span>\n        </a>\n        <p class=\"text-xs text-center text-[#8E887E]\">\n          Geithainer Str. 32 · 04680 Colditz<br>\n          Mo–Fr: 08:00 – 15:30 Uhr\n        </p>\n      </div>\n    </div>\n  </div>\n\n  <!-- HERO SECTION -->\n  <section class=\"pt-20 pb-16 max-w-[1340px] mx-auto px-6\">\n    <div class=\"max-w-3xl\">\n      <span class=\"text-xs font-semibold tracking-widest text-[#E31936] uppercase block mb-3\">\n        Werkstatt · Sägewerk · Baustellen · Zukunft\n      </span>\n      <h1 class=\"font-heading font-extrabold text-4xl sm:text-6xl text-[#1A1918] tracking-tight leading-[1.1] mb-6\">\n        Aktuelles & Einblicke aus Meisterhand.\n      </h1>\n      <p class=\"text-lg text-text-secondary leading-relaxed\">\n        Neuigkeiten aus unserer Werkstatt in Colditz: Aktuelle Bauprojekte, Holzbau-Tipps, Wissenswertes zu Kaminpellets und unsere geförderte Zukunftsausstattung.\n      </p>\n    </div>\n\n    <!-- SOMERVILLE CATEGORY FILTER PILLS -->\n    <div class=\"flex flex-wrap items-center gap-2.5 sm:gap-3 mt-12 pt-8 border-t border-[#1A1918]/10\" id=\"filter-container\">\n      <button class=\"filter-pill active\" data-filter=\"all\">Alle Beiträge (6)</button>\n      <button class=\"filter-pill\" data-filter=\"foerderung\">Förderung & Zukunft (1)</button>\n      <button class=\"filter-pill\" data-filter=\"pellets\">Pellets & Sägewerk (2)</button>\n      <button class=\"filter-pill\" data-filter=\"holzbau\">Holzbau & Handwerk (2)</button>\n      <button class=\"filter-pill\" data-filter=\"denkmal\">Denkmal & Sanierung (1)</button>\n    </div>\n  </section>\n\n  <!-- MAGAZINE GRID SECTION -->\n  <section class=\"pb-28 max-w-[1340px] mx-auto px-6\">\n    <div class=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8\" id=\"posts-grid\">\n\n      <!-- Post 1: SAB / EU Förderung (Highlight) -->\n      <article class=\"post-card bg-white rounded-[28px] overflow-hidden shadow-sm hover:shadow-xl transition-all duration-300 flex flex-col justify-between border border-[#1A1918]/5 group\" data-category=\"foerderung\">\n        <div>\n          <div class=\"aspect-[16/10] bg-[#F8F5EE] p-6 flex items-center justify-center relative overflow-hidden border-b border-[#1A1918]/5\">\n            <img \n              src=\"https://bau-mueller.eu/wp-content/uploads/2026/03/EFRE-ESF_LO_Kombination_EU-Logo_SachsenSignet-klassisch_HF_RGB_300dpi.jpg\" \n              alt=\"EFRE EU und Freistaat Sachsen Förderlogos Werkstatt der Zukunft\" \n              class=\"max-h-full max-w-full object-contain transition-transform duration-500 group-hover:scale-105\"\n            >\n            <div class=\"absolute top-4 left-4\">\n              <span class=\"text-[10px] font-bold tracking-wider uppercase px-2.5 py-1 rounded-full bg-[#2563EB] text-white\">\n                Offiziell gefördert\n              </span>\n            </div>\n          </div>\n          <div class=\"p-6 sm:p-8\">\n            <div class=\"flex items-center gap-3 text-xs text-[#7A756E] mb-3 font-medium\">\n              <span class=\"text-[#2563EB] font-semibold\">EU & Freistaat Sachsen</span>\n              <span>·</span>\n              <time datetime=\"2026-03-02\">02. März 2026</time>\n            </div>\n            <h2 class=\"font-heading font-bold text-xl sm:text-2xl text-[#1A1918] mb-3 leading-snug group-hover:text-[#E31936] transition-colors\">\n              Werkstatt der Zukunft – Präzision trifft Tradition\n            </h2>\n            <p class=\"text-sm text-[#5C564F] leading-relaxed mb-6\">\n              Unser Projekt zur Modernisierung der Werkstatt wird durch die Europäische Union und den Freistaat Sachsen über die Sächsische Aufbaubank (SAB) gefördert.\n            </p>\n          </div>\n        </div>\n        <div class=\"px-6 sm:px-8 pb-6 sm:pb-8 pt-0\">\n          <a href=\"/werkstatt-der-zukunft-praezision-trifft-tradition/\" class=\"btn-pill-dark w-full justify-between text-xs sm:text-sm\">\n            <span>Artikel & Details lesen</span>\n            <svg class=\"w-3.5 h-3.5 text-[#E31936]\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n              <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.5\" d=\"M14 5l7 7m0 0l-7 7m7-7H3\"/>\n            </svg>\n          </a>\n        </div>\n      </article>\n\n      <!-- Post 2: Kaminpellets -->\n      <article class=\"post-card bg-white rounded-[28px] overflow-hidden shadow-sm hover:shadow-xl transition-all duration-300 flex flex-col justify-between border border-[#1A1918]/5 group\" data-category=\"pellets\">\n        <div>\n          <div class=\"aspect-[16/10] bg-[#EAE5D9] relative overflow-hidden\">\n            <img \n              src=\"https://bau-mueller.eu/wp-content/uploads/2025/08/Tor-Zimmerei-Mueller.jpeg\" \n              alt=\"Pellets und Holzbriketts aus eigener Produktion in Colditz\" \n              class=\"w-full h-full object-cover transition-transform duration-500 group-hover:scale-105\"\n            >\n            <div class=\"absolute top-4 left-4\">\n              <span class=\"text-[10px] font-bold tracking-wider uppercase px-2.5 py-1 rounded-full bg-[#E31936] text-white\">\n                Lagerware\n              </span>\n            </div>\n          </div>\n          <div class=\"p-6 sm:p-8\">\n            <div class=\"flex items-center gap-3 text-xs text-[#7A756E] mb-3 font-medium\">\n              <span class=\"text-[#E31936] font-semibold\">Brennstoffe ab Werk</span>\n              <span>·</span>\n              <time datetime=\"2023-08-20\">20. August 2023</time>\n            </div>\n            <h2 class=\"font-heading font-bold text-xl sm:text-2xl text-[#1A1918] mb-3 leading-snug group-hover:text-[#E31936] transition-colors\">\n              Wärme mit Stil – Unsere Pellets für Ihren Kamin\n            </h2>\n            <p class=\"text-sm text-[#5C564F] leading-relaxed mb-6\">\n              Holen Sie sich hochwertige Holzpellets und Holzbriketts direkt ab Werk. 100% naturbelassen aus eigenen Spänen ohne Bindemittel – effizient heizen.\n            </p>\n          </div>\n        </div>\n        <div class=\"px-6 sm:px-8 pb-6 sm:pb-8 pt-0\">\n          <a href=\"/waerme-mit-stil-unsere-pellets-fuer-ihren-kamine/\" class=\"btn-pill-dark w-full justify-between text-xs sm:text-sm\">\n            <span>Preise & Abholung ansehen</span>\n            <svg class=\"w-3.5 h-3.5 text-[#E31936]\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n              <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.5\" d=\"M14 5l7 7m0 0l-7 7m7-7H3\"/>\n            </svg>\n          </a>\n        </div>\n      </article>\n\n      <!-- Post 3: Lohnschnitt Sägewerk -->\n      <article class=\"post-card bg-white rounded-[28px] overflow-hidden shadow-sm hover:shadow-xl transition-all duration-300 flex flex-col justify-between border border-[#1A1918]/5 group\" data-category=\"pellets\">\n        <div>\n          <div class=\"aspect-[16/10] bg-[#EAE5D9] relative overflow-hidden\">\n            <img \n              src=\"https://bau-mueller.eu/wp-content/uploads/2018/11/c3ea0d76-5cd2-4630-a414-be8fb83a1031.webp\" \n              alt=\"Sägewerk Lohnschnitt Zuschnittservice Colditz\" \n              class=\"w-full h-full object-cover transition-transform duration-500 group-hover:scale-105\"\n            >\n            <div class=\"absolute top-4 left-4\">\n              <span class=\"text-[10px] font-bold tracking-wider uppercase px-2.5 py-1 rounded-full bg-[#1A1918] text-white\">\n                Werkstattservice\n              </span>\n            </div>\n          </div>\n          <div class=\"p-6 sm:p-8\">\n            <div class=\"flex items-center gap-3 text-xs text-[#7A756E] mb-3 font-medium\">\n              <span class=\"text-[#1A1918] font-semibold\">Sägewerk Colditz</span>\n              <span>·</span>\n              <time datetime=\"2022-11-04\">04. November 2022</time>\n            </div>\n            <h2 class=\"font-heading font-bold text-xl sm:text-2xl text-[#1A1918] mb-3 leading-snug group-hover:text-[#E31936] transition-colors\">\n              Lohnschnitt im neuen Sägewerk\n            </h2>\n            <p class=\"text-sm text-[#5C564F] leading-relaxed mb-6\">\n              Unser Sägewerk schneidet Stämme aller Holzarten zu Balken, Brettern, Dielen, Latten und Kanthölzern – millimetergenau nach Ihren Maßvorgaben.\n            </p>\n          </div>\n        </div>\n        <div class=\"px-6 sm:px-8 pb-6 sm:pb-8 pt-0\">\n          <a href=\"/lohnschnitt-im-neuen-saegewerk/\" class=\"btn-pill-dark w-full justify-between text-xs sm:text-sm\">\n            <span>Schnittanfrage stellen</span>\n            <svg class=\"w-3.5 h-3.5 text-[#E31936]\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n              <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.5\" d=\"M14 5l7 7m0 0l-7 7m7-7H3\"/>\n            </svg>\n          </a>\n        </div>\n      </article>\n\n      <!-- Post 4: Denkmalgerechte Altbausanierung -->\n      <article class=\"post-card bg-white rounded-[28px] overflow-hidden shadow-sm hover:shadow-xl transition-all duration-300 flex flex-col justify-between border border-[#1A1918]/5 group\" data-category=\"denkmal\">\n        <div>\n          <div class=\"aspect-[16/10] bg-[#EAE5D9] relative overflow-hidden\">\n            <img \n              src=\"https://bau-mueller.eu/wp-content/uploads/2022/04/Putzsanierung-Kirchturm-Zschirla.jpeg\" \n              alt=\"Putz- und Holzarbeiten an historischem Kirchturm in Zschirla\" \n              class=\"w-full h-full object-cover transition-transform duration-500 group-hover:scale-105\"\n            >\n          </div>\n          <div class=\"p-6 sm:p-8\">\n            <div class=\"flex items-center gap-3 text-xs text-[#7A756E] mb-3 font-medium\">\n              <span class=\"text-[#E31936] font-semibold\">Denkmalpflege</span>\n              <span>·</span>\n              <time datetime=\"2024-06-03\">03. Juni 2024</time>\n            </div>\n            <h2 class=\"font-heading font-bold text-xl sm:text-2xl text-[#1A1918] mb-3 leading-snug group-hover:text-[#E31936] transition-colors\">\n              Denkmalgerechte Altbausanierung: Holzarbeiten\n            </h2>\n            <p class=\"text-sm text-[#5C564F] leading-relaxed mb-6\">\n              Besondere Sorgfalt und historisches Fachwissen: Wie wir historische Fachwerk- und Dachkonstruktionen originalgetreu ertüchtigen und erhalten.\n            </p>\n          </div>\n        </div>\n        <div class=\"px-6 sm:px-8 pb-6 sm:pb-8 pt-0\">\n          <a href=\"/denkmalgerechte-altbausanierung-holzarbeiten-an-historischen-gebaeuden/\" class=\"btn-pill-dark w-full justify-between text-xs sm:text-sm\">\n            <span>Fachbericht lesen</span>\n            <svg class=\"w-3.5 h-3.5 text-[#E31936]\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n              <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.5\" d=\"M14 5l7 7m0 0l-7 7m7-7H3\"/>\n            </svg>\n          </a>\n        </div>\n      </article>\n\n      <!-- Post 5: Binderdachstuhl -->\n      <article class=\"post-card bg-white rounded-[28px] overflow-hidden shadow-sm hover:shadow-xl transition-all duration-300 flex flex-col justify-between border border-[#1A1918]/5 group\" data-category=\"holzbau\">\n        <div>\n          <div class=\"aspect-[16/10] bg-[#EAE5D9] relative overflow-hidden\">\n            <img \n              src=\"https://bau-mueller.eu/wp-content/uploads/2022/04/Wangentreppe-viertelgewendelt-Koltzschen.jpeg\" \n              alt=\"Präziser Holzbau und Binderkonstruktionen Zimmerei Müller\" \n              class=\"w-full h-full object-cover transition-transform duration-500 group-hover:scale-105\"\n            >\n          </div>\n          <div class=\"p-6 sm:p-8\">\n            <div class=\"flex items-center gap-3 text-xs text-[#7A756E] mb-3 font-medium\">\n              <span class=\"text-[#E31936] font-semibold\">Zimmerei & Holzbau</span>\n              <span>·</span>\n              <time datetime=\"2022-11-04\">04. November 2022</time>\n            </div>\n            <h2 class=\"font-heading font-bold text-xl sm:text-2xl text-[#1A1918] mb-3 leading-snug group-hover:text-[#E31936] transition-colors\">\n              Binderdachstuhl – Maßgefertigte Dachkonstruktionen\n            </h2>\n            <p class=\"text-sm text-[#5C564F] leading-relaxed mb-6\">\n              Wirtschaftlich, langlebig und flexibel einsetzbar: Warum der Nagelplattenbinder für Hallenbauten und weitgespannte Dächer die erste Wahl ist.\n            </p>\n          </div>\n        </div>\n        <div class=\"px-6 sm:px-8 pb-6 sm:pb-8 pt-0\">\n          <a href=\"/binderdachstuhl/\" class=\"btn-pill-dark w-full justify-between text-xs sm:text-sm\">\n            <span>Konstruktionsdetails</span>\n            <svg class=\"w-3.5 h-3.5 text-[#E31936]\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n              <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.5\" d=\"M14 5l7 7m0 0l-7 7m7-7H3\"/>\n            </svg>\n          </a>\n        </div>\n      </article>\n\n      <!-- Post 6: Wärmedämmung Fassade -->\n      <article class=\"post-card bg-white rounded-[28px] overflow-hidden shadow-sm hover:shadow-xl transition-all duration-300 flex flex-col justify-between border border-[#1A1918]/5 group\" data-category=\"holzbau\">\n        <div>\n          <div class=\"aspect-[16/10] bg-[#EAE5D9] relative overflow-hidden\">\n            <img \n              src=\"https://bau-mueller.eu/wp-content/uploads/2024/06/aa704001-60a5-40bb-86b0-15f04b8ce571.webp\" \n              alt=\"Energetische Sanierung und Fassadendämmung Colditz\" \n              class=\"w-full h-full object-cover transition-transform duration-500 group-hover:scale-105\"\n            >\n          </div>\n          <div class=\"p-6 sm:p-8\">\n            <div class=\"flex items-center gap-3 text-xs text-[#7A756E] mb-3 font-medium\">\n              <span class=\"text-[#E31936] font-semibold\">Energetisch Sanieren</span>\n              <span>·</span>\n              <time datetime=\"2022-11-03\">03. November 2022</time>\n            </div>\n            <h2 class=\"font-heading font-bold text-xl sm:text-2xl text-[#1A1918] mb-3 leading-snug group-hover:text-[#E31936] transition-colors\">\n              Was kostet eine Wärmedämmung für die Fassade?\n            </h2>\n            <p class=\"text-sm text-[#5C564F] leading-relaxed mb-6\">\n              Kostenfaktoren, Fördermöglichkeiten und ökologische Dämmstoffe: Warum sich eine professionell ausgeführte Dämmung bereits nach wenigen Jahren rechnet.\n            </p>\n          </div>\n        </div>\n        <div class=\"px-6 sm:px-8 pb-6 sm:pb-8 pt-0\">\n          <a href=\"/waermedaemmung-fuer-meine-fassade/\" class=\"btn-pill-dark w-full justify-between text-xs sm:text-sm\">\n            <span>Ratgeber lesen</span>\n            <svg class=\"w-3.5 h-3.5 text-[#E31936]\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n              <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.5\" d=\"M14 5l7 7m0 0l-7 7m7-7H3\"/>\n            </svg>\n          </a>\n        </div>\n      </article>\n\n    </div>\n  </section>\n\n  <!-- 7. FOOTER (SOMERVILLE STYLE ARCHITECTURAL SLAB) -->\n    <!-- 7. FOOTER (SOMERVILLE STYLE ARCHITECTURAL SLAB) -->\n  <footer id=\"kontakt\" class=\"bg-charcoal text-cream pt-20 pb-12 rounded-t-[40px]\">\n    <div class=\"max-w-[1340px] mx-auto px-6 lg:px-10\">\n      \n      <!-- Contact Header & Interactive Inquiry Form -->\n      <div class=\"pb-16 border-b border-white/10\">\n        <div class=\"grid grid-cols-1 lg:grid-cols-12 gap-12 items-start\">\n          \n          <!-- Left Column: Intro & Direct Contact Badges -->\n          <div class=\"lg:col-span-5\">\n            <span class=\"text-xs font-semibold tracking-widest text-[#E31936] uppercase block mb-3\">\n              Kontakt & Vorhaben besprechen\n            </span>\n            <h2 class=\"font-heading font-bold text-3xl sm:text-4xl text-[#FFFCF5] leading-tight mb-6\">\n              Bereit für Ihr nächstes Bauvorhaben? Sprechen Sie mit uns.\n            </h2>\n            <p class=\"text-sm sm:text-base text-[#A39E93] leading-relaxed mb-8\">\n              Ob traditioneller Dachstuhl, maßgefertigte Treppe, Lohnschnitt im Sägewerk oder Gesamtsanierung – Meister Tobias Müller und unser Team beraten Sie persönlich, verlässlich und fachgerecht.\n            </p>\n\n            <div class=\"space-y-4\">\n              <a href=\"tel:+493438143336\" class=\"flex items-center gap-4 p-4 rounded-2xl bg-white/5 hover:bg-white/10 border border-white/10 transition-all group\">\n                <div class=\"w-12 h-12 rounded-xl bg-[#E31936] flex items-center justify-center text-white shrink-0 group-hover:scale-105 transition-transform\">\n                  <svg class=\"w-5 h-5\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n                    <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z\"/>\n                  </svg>\n                </div>\n                <div>\n                  <span class=\"text-xs text-[#A39E93] uppercase tracking-wider block\">Telefonische Direktberatung