        {
          "id": "html_leistungen",
          "elType": "widget",
          "widgetType": "html",
          "settings": {
            "html": "<!-- SOMERVILLE ARCHITECTURAL CRAFT DESIGN: NEU – Leistungen -->\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link href=\"https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Inter:wght@400;500;600&display=swap\" rel=\"stylesheet\">\n<script src=\"https://cdn.tailwindcss.com\"></script>\n<style>\nbody {\n      font-family: 'Inter', sans-serif;\n      background-color: #F8F5EE;\n      color: #1A1918;\n      -webkit-font-smoothing: antialiased;\n    }\n    h1, h2, h3, h4, .font-heading {\n      font-family: 'Plus Jakarta Sans', sans-serif;\n      letter-spacing: -0.028em;\n    }\n    .bg-cream { background-color: #F8F5EE; }\n    .bg-charcoal { background-color: #1C1B1A; }\n    .bg-charcoal-card { background-color: #262523; }\n    .text-charcoal { color: #1A1918; }\n    .text-cream { color: #FAF7F2; }\n    .text-muted-dark { color: #9C968F; }\n    .accent-red { color: #E31936; }\n\n    .btn-pill-dark {\n      background-color: #1C1B1A;\n      color: #FAF7F2;\n      border-radius: 9999px;\n      padding: 12px 26px;\n      font-size: 14px;\n      font-weight: 600;\n      display: inline-flex;\n      align-items: center;\n      gap: 10px;\n      transition: all 0.25s ease;\n    }\n    .btn-pill-dark:hover {\n      background-color: #2F2E2C;\n      transform: translateY(-1px);\n    }\n    .btn-pill-light {\n      background-color: #FAF7F2;\n      color: #1C1B1A;\n      border-radius: 9999px;\n      padding: 12px 26px;\n      font-size: 14px;\n      font-weight: 600;\n      display: inline-flex;\n      align-items: center;\n      gap: 10px;\n      transition: all 0.25s ease;\n    }\n    .btn-pill-light:hover {\n      background-color: #FFFFFF;\n      transform: translateY(-1px);\n    }\n\n    .action-circle-badge {\n      position: absolute;\n      bottom: 16px;\n      right: 16px;\n      width: 44px;\n      height: 44px;\n      background-color: #FFFFFF;\n      border-radius: 50%;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      box-shadow: 0 4px 14px rgba(0, 0, 0, 0.14);\n      transition: transform 0.3s ease, background-color 0.3s ease;\n    }\n    .group:hover .action-circle-badge {\n      transform: scale(1.1);\n      background-color: #FAF7F2;\n    }\n    \n    .editorial-link-hover {\n      background-image: linear-gradient(currentColor, currentColor);\n      background-position: 0% 100%;\n      background-repeat: no-repeat;\n      background-size: 0% 2px;\n      transition: background-size .3s ease;\n    }\n    .group:hover .editorial-link-hover {\n      background-size: 100% 2px;\n    }\n</style>\n\n<div class=\"somerville-container w-full bg-[#F8F5EE] text-[#1A1918] antialiased\" style=\"font-family: 'Inter', sans-serif;\">\n<!-- TOP HEADER (MINIMALIST, ARCHITECTURAL SOMERVILLE) -->\n  <header class=\"sticky top-0 z-50 bg-[#F8F5EE]/95 backdrop-blur-md border-b border-[#E8E3D8] transition-all\">\n    <div class=\"max-w-[1400px] mx-auto px-4 sm:px-6 py-4 flex items-center justify-between\">\n      \n      <!-- Left: Mobile Menu Toggle Button & Desktop Nav -->\n      <div class=\"flex items-center gap-6 sm:gap-8\">\n        <button id=\"menu-toggle-btn\" class=\"flex items-center gap-2.5 text-xs font-semibold tracking-wider uppercase text-[#1A1918] hover:text-[#E31936] transition-colors focus:outline-none\" aria-label=\"Menü öffnen\">\n          <span class=\"w-5 flex flex-col gap-1\">\n            <span class=\"block w-5 h-0.5 bg-current transition-all\"></span>\n            <span class=\"block w-3.5 h-0.5 bg-current transition-all\"></span>\n          </span>\n          <span class=\"inline\">Menü</span>\n        </button>\n        <nav class=\"hidden lg:flex items-center gap-7 text-sm font-medium text-[#4A4641]\">\n          <a href=\"/leistungen/\" class=\"text-[#1A1918] font-bold border-b-2 border-[#1A1918] pb-0.5\">Leistungen</a>\n          <a href=\"/#werkstatt\" class=\"hover:text-[#1A1918] transition-colors\">Werkstatt & Sägewerk</a>\n          <a href=\"/projects/\" class=\"hover:text-[#1A1918] transition-colors\">Referenzen</a>\n          <a href=\"/#nachhaltigkeit\" class=\"hover:text-[#1A1918] transition-colors flex items-center gap-1.5\">\n            Pellets <span class=\"text-[10px] font-bold px-1.5 py-0.5 rounded-full bg-[#E31936] text-white\">Öko</span>\n          </a>\n          <a href=\"/about/\" class=\"hover:text-[#1A1918] transition-colors\">Über uns</a>\n        </nav>\n      </div>\n\n      <!-- Center: Architectural Brand Identity -->\n      <div class=\"text-center\">\n        <a href=\"/\" class=\"inline-block\">\n          <span class=\"block font-heading font-extrabold text-lg sm:text-xl md:text-2xl tracking-tight text-[#1A1918] uppercase\">\n            Arthur Müller\n          </span>\n          <span class=\"block text-[9px] sm:text-[10px] tracking-[0.25em] uppercase text-[#7A756E] font-medium mt-0.5\">\n            Zimmerei & Baugeschäft · Seit 1920\n          </span>\n        </a>\n      </div>\n\n      <!-- Right: Direct Phone CTA & Project Button -->\n      <div class=\"flex items-center gap-3 sm:gap-4\">\n        <a href=\"tel:+493438143336\" class=\"hidden sm:inline-block text-xs font-semibold text-[#4A4641] hover:text-[#1A1918] transition-colors\">\n          034381 43336\n        </a>\n        <a href=\"#kontakt\" class=\"btn-pill-dark text-xs sm:text-sm\">\n          <span>Projekt anfragen</span>\n          <svg class=\"w-3.5 h-3.5 text-[#E31936]\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n            <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.5\" d=\"M14 5l7 7m0 0l-7 7m7-7H3\"/>\n          </svg>\n        </a>\n      </div>\n    </div>\n  </header>\n\n  <!-- MOBILE / OFF-CANVAS NAVIGATION DRAWER -->\n  <div id=\"mobile-menu-drawer\" class=\"fixed inset-0 z-[100] transition-opacity duration-300 opacity-0 pointer-events-none\" aria-hidden=\"true\">\n    <div id=\"mobile-menu-backdrop\" class=\"absolute inset-0 bg-[#1C1B1A]/80 backdrop-blur-md\"></div>\n    <div id=\"mobile-menu-panel\" class=\"absolute top-0 left-0 bottom-0 w-full max-w-sm sm:max-w-md bg-[#1C1B1A] text-[#F8F5EE] shadow-2xl flex flex-col justify-between p-6 sm:p-8 transform -translate-x-full transition-transform duration-300 ease-out border-r border-white/10 overflow-y-auto\">\n      <div>\n        <div class=\"flex items-center justify-between pb-6 border-b border-white/10\">\n          <div>\n            <span class=\"block font-heading font-extrabold text-lg tracking-tight uppercase text-white\">\n              Arthur Müller\n            </span>\n            <span class=\"block text-[10px] tracking-[0.2em] uppercase text-[#A39E93] mt-0.5 font-medium\">\n              Zimmerei & Baugeschäft · 1920\n            </span>\n          </div>\n          <button id=\"mobile-menu-close\" class=\"w-10 h-10 rounded-full bg-white/10 hover:bg-white/20 flex items-center justify-center text-white transition-colors focus:outline-none\" aria-label=\"Menü schließen\">\n            <svg class=\"w-5 h-5\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n              <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M6 18L18 6M6 6l12 12\"/>\n            </svg>\n          </button>\n        </div>\n\n        <nav class=\"mt-6 flex flex-col gap-2\">\n          <a href=\"/\" class=\"mobile-nav-link text-base sm:text-lg font-semibold text-white/90 hover:text-white py-2.5 flex items-center justify-between border-b border-white/5 transition-colors\">\n            <span>Startseite</span>\n            <span class=\"text-xs text-[#E31936]\">01</span>\n          </a>\n          <a href=\"/leistungen/\" class=\"mobile-nav-link text-base sm:text-lg font-semibold text-white/90 hover:text-white py-2.5 flex items-center justify-between border-b border-white/5 transition-colors\">\n            <span>Leistungen & Handwerk</span>\n            <span class=\"text-xs text-[#E31936]\">02</span>\n          </a>\n          <a href=\"/#werkstatt\" class=\"mobile-nav-link text-base sm:text-lg font-semibold text-white/90 hover:text-white py-2.5 flex items-center justify-between border-b border-white/5 transition-colors\">\n            <span>Werkstatt & Sägewerk</span>\n            <span class=\"text-xs text-[#E31936]\">03</span>\n          </a>\n          <a href=\"/projects/\" class=\"mobile-nav-link text-base sm:text-lg font-semibold text-white/90 hover:text-white py-2.5 flex items-center justify-between border-b border-white/5 transition-colors\">\n            <span>Referenzen & Bauten</span>\n            <span class=\"text-xs text-[#E31936]\">04</span>\n          </a>\n          <a href=\"/about/\" class=\"mobile-nav-link text-base sm:text-lg font-semibold text-white/90 hover:text-white py-2.5 flex items-center justify-between border-b border-white/5 transition-colors\">\n            <span>Über uns (4. Generation)</span>\n            <span class=\"text-xs text-[#E31936]\">05</span>\n          </a>\n          <a href=\"/#nachhaltigkeit\" class=\"mobile-nav-link text-base sm:text-lg font-semibold text-white/90 hover:text-white py-2.5 flex items-center justify-between border-b border-white/5 transition-colors\">\n            <span class=\"flex items-center gap-2\">\n              Pellet- & Holzbriketts\n              <span class=\"text-[10px] font-bold px-2 py-0.5 rounded-full bg-[#E31936] text-white\">Öko</span>\n            </span>\n            <span class=\"text-xs text-[#E31936]\">06</span>\n          </a>\n        </nav>\n      </div>\n\n      <div class=\"pt-6 border-t border-white/10 space-y-4 mt-6\">\n        <a href=\"tel:+493438143336\" class=\"w-full py-3 px-4 rounded-full bg-white/10 hover:bg-white/15 text-white flex items-center justify-center gap-2 text-sm font-semibold transition-colors\">\n          <svg class=\"w-4 h-4 text-[#E31936]\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n            <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z\"/>\n          </svg>\n          <span>034381 43336</span>\n        </a>\n        <a href=\"#kontakt\" class=\"btn-pill-light w-full justify-center text-sm py-3 mobile-nav-link\">\n          <span>Projekt anfragen</span>\n          <svg class=\"w-4 h-4 text-[#1C1B1A]\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n            <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.5\" d=\"M14 5l7 7m0 0l-7 7m7-7H3\"/>\n          </svg>\n        </a>\n        <div class=\"text-[11px] text-center text-[#A39E93] leading-relaxed\">\n          Geithainer Str. 32 · 04680 Colditz<br>\n          Mo–Fr: 08:00 – 15:30 Uhr\n        </div>\n      </div>\n    </div>\n  </div>\n\n  <script>\n    (function() {\n      var toggleBtn = document.getElementById('menu-toggle-btn');\n      var drawer = document.getElementById('mobile-menu-drawer');\n      var panel = document.getElementById('mobile-menu-panel');\n      var backdrop = document.getElementById('mobile-menu-backdrop');\n      var closeBtn = document.getElementById('mobile-menu-close');\n      var navLinks = document.querySelectorAll('.mobile-nav-link');\n\n      function openMenu() {\n        if (!drawer) return;\n        drawer.classList.remove('opacity-0', 'pointer-events-none');\n        drawer.classList.add('opacity-100', 'pointer-events-auto');\n        panel.classList.remove('-translate-x-full');\n        panel.classList.add('translate-x-0');\n        document.body.style.overflow = 'hidden';\n      }\n\n      function closeMenu() {\n        if (!drawer) return;\n        drawer.classList.remove('opacity-100', 'pointer-events-auto');\n        drawer.classList.add('opacity-0', 'pointer-events-none');\n        panel.classList.remove('translate-x-0');\n        panel.classList.add('-translate-x-full');\n        document.body.style.overflow = '';\n      }\n\n      if (toggleBtn) toggleBtn.addEventListener('click', openMenu);\n      if (closeBtn) closeBtn.addEventListener('click', closeMenu);\n      if (backdrop) backdrop.addEventListener('click', closeMenu);\n      navLinks.forEach(function(link) {\n        link.addEventListener('click', closeMenu);\n      });\n      document.addEventListener('keydown', function(e) {\n        if (e.key === 'Escape') closeMenu();\n      });\n    })();\n  </script>\n\n  <!-- HERO SECTION: LEISTUNGEN HUB -->\n  <section class=\"py-20 px-6 max-w-[1340px] mx-auto border-b border-[#E8E3D8]\">\n    <span class=\"text-xs uppercase tracking-[0.2em] font-semibold text-[#E31936] block mb-3\">\n      Gewerkeübergreifend · Alles aus einer Hand\n    </span>\n    <h1 class=\"font-heading font-extrabold text-4xl sm:text-6xl text-[#1A1918] leading-[1.1] max-w-4xl tracking-tight\">\n      Handwerkliche Meisterschaft vom Holzbau bis zum Massivbau.\n    </h1>\n    <p class=\"mt-6 text-lg text-[#6E6963] max-w-2xl leading-relaxed\">\n      Als kombinierte Zimmerei und Baugeschäft vereinen wir Planung, computergestützten Abbund, individuellen Treppenbau, Massivbau und nachhaltige Reststoffverwertung.\n    </p>\n  </section>\n\n  <!-- 5 GROSSE GEWERKE-KARTEN (SOMERVILLE STYLE: ECHTE BILDER) -->\n  <section class=\"py-20 max-w-[1340px] mx-auto px-6 space-y-16\">\n    \n    <!-- 1. Zimmerei & Holzbau -->\n    <div class=\"grid grid-cols-1 lg:grid-cols-12 gap-10 items-center\">\n      <div class=\"lg:col-span-6\">\n        <div class=\"relative aspect-[16/10] rounded-[28px] overflow-hidden bg-[#EAE5D9] group\">\n          <img \n            src=\"https://bau-mueller.eu/wp-content/uploads/2022/04/Dachstuhl-Sanierung-Kirche-Wildenhain.jpeg\" \n            alt=\"Zimmerei & Dachstühle\" \n            class=\"w-full h-full object-cover group-hover:scale-105 transition-transform duration-700\"\n          >\n          <div class=\"action-circle-badge\">\n            <svg class=\"w-4 h-4 text-[#E31936]\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\">\n              <line x1=\"12\" y1=\"5\" x2=\"12\" y2=\"19\"></line>\n              <line x1=\"5\" y1=\"12\" x2=\"19\" y2=\"12\"></line>\n            </svg>\n          </div>\n        </div>\n      </div>\n      <div class=\"lg:col-span-6 lg:pl-6\">\n        <span class=\"text-xs font-semibold tracking-wider text-[#E31936] uppercase block mb-2\">Gewerk 01</span>\n        <h2 class=\"font-heading font-bold text-3xl text-[#1A1918] mb-4\">Zimmerei & konstruktiver Holzbau</h2>\n        <p class=\"text-[#6E6963] text-base leading-relaxed mb-4\">\n          Traditionelle und moderne Dachstühle, Sichtdachstühle, Carports, Gauben, Vordächer und gewerbliche Hallenkonstruktionen. Durch den eigenen Abbund in Colditz montieren wir zügig, passgenau und wetterunabhängig vorbereitet.\n        </p>\n        <ul class=\"text-xs font-semibold text-[#4A4641] space-y-2 mb-6 uppercase tracking-wider\">\n          <li>✓ Millimetergenauer Werkstattabbund</li>\n          <li>✓ Sattel-, Walm- und Mansarddächer</li>\n          <li>✓ Carports & Holzfassaden</li>\n        </ul>\n        <a href=\"#kontakt\" class=\"btn-pill-dark\">\n          <span>Dachstuhl anfragen</span>\n          <svg class=\"w-3.5 h-3.5 text-[#E31936]\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n            <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.5\" d=\"M14 5l7 7m0 0l-7 7m7-7H3\"/>\n          </svg>\n        </a>\n      </div>\n    </div>\n\n    <!-- 2. Treppen- & Möbelbau -->\n    <div class=\"grid grid-cols-1 lg:grid-cols-12 gap-10 items-center\">\n      <div class=\"lg:col-span-6 lg:order-2\">\n        <div class=\"relative aspect-[16/10] rounded-[28px] overflow-hidden bg-[#EAE5D9] group\">\n          <img \n            src=\"https://bau-mueller.eu/wp-content/uploads/2022/04/Wangentreppe-viertelgewendelt-Koltzschen.jpeg\" \n            alt=\"Treppenbau & Möbelbau\" \n            class=\"w-full h-full object-cover group-hover:scale-105 transition-transform duration-700\"\n          >\n          <div class=\"action-circle-badge\">\n            <svg class=\"w-4 h-4 text-[#E31936]\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\">\n              <line x1=\"12\" y1=\"5\" x2=\"12\" y2=\"19\"></line>\n              <line x1=\"5\" y1=\"12\" x2=\"19\" y2=\"12\"></line>\n            </svg>\n          </div>\n        </div>\n      </div>\n      <div class=\"lg:col-span-6 lg:order-1 lg:pr-6\">\n        <span class=\"text-xs font-semibold tracking-wider text-[#E31936] uppercase block mb-2\">Gewerk 02</span>\n        <h2 class=\"font-heading font-bold text-3xl text-[#1A1918] mb-4\">Treppen- & individueller Möbelbau</h2>\n        <p class=\"text-[#6E6963] text-base leading-relaxed mb-4\">\n          Maßgefertigte Massivholztreppen verleihen Wohnräumen eine unvergleichliche Wärme. Wir fertigen gewendelte Wangentreppen, geradläufige Treppenanlagen, Geländer und passgenaue Möbel aus heimischer Eiche, Buche und Esche.\n        </p>\n        <ul class=\"text-xs font-semibold text-[#4A4641] space-y-2 mb-6 uppercase tracking-wider\">\n          <li>✓ Gewendelte & gerade Massivholztreppen</li>\n          <li>✓ Individuelle Geländer & Staketen</li>\n          <li>✓ Passgenauer Innenausbau nach Maß</li>\n        </ul>\n        <a href=\"#kontakt\" class=\"btn-pill-dark\">\n          <span>Treppenbau anfragen</span>\n          <svg class=\"w-3.5 h-3.5 text-[#E31936]\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n            <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.5\" d=\"M14 5l7 7m0 0l-7 7m7-7H3\"/>\n          </svg>\n        </a>\n      </div>\n    </div>\n\n    <!-- 3. Sägewerk & Lohnschnitt (Echtes Foto start4.jpg) -->\n    <div class=\"grid grid-cols-1 lg:grid-cols-12 gap-10 items-center\">\n      <div class=\"lg:col-span-6\">\n        <div class=\"relative aspect-[16/10] rounded-[28px] overflow-hidden bg-[#EAE5D9] group\">\n          <img \n            src=\"https://bau-mueller.eu/wp-content/uploads/2022/02/start4-768x1151.jpg\" \n            alt=\"Sägewerk und Lohnschnitt Arthur Müller\" \n            class=\"w-full h-full object-cover group-hover:scale-105 transition-transform duration-700\"\n          >\n          <div class=\"action-circle-badge\">\n            <svg class=\"w-4 h-4 text-[#E31936]\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\">\n              <line x1=\"12\" y1=\"5\" x2=\"12\" y2=\"19\"></line>\n              <line x1=\"5\" y1=\"12\" x2=\"19\" y2=\"12\"></line>\n            </svg>\n          </div>\n        </div>\n      </div>\n      <div class=\"lg:col-span-6 lg:pl-6\">\n        <span class=\"text-xs font-semibold tracking-wider text-[#E31936] uppercase block mb-2\">Kapazität 03</span>\n        <h2 class=\"font-heading font-bold text-3xl text-[#1A1918] mb-4\">Eigenes Sägewerk & Lohnschnitt</h2>\n        <p class=\"text-[#6E6963] text-base leading-relaxed mb-4\">\n          Unser neues Sägewerk verarbeitet Stämme aller Holzarten bis zu 80 cm Durchmesser und 9 m Länge. Wir sägen Kanthölzer, Bohlen, Bretter, Latten und Spezialschnitte für private Waldbesitzer, Bauherren und Handwerksbetriebe.\n        </p>\n        <ul class=\"text-xs font-semibold text-[#4A4641] space-y-2 mb-6 uppercase tracking-wider\">\n          <li>✓ Stammdurchmesser bis 80 cm, Länge bis 9 m</li>\n          <li>✓ Lohnschnitt nach individueller Schnittliste</li>\n          <li>✓ Flexible Sondermaße während der Bearbeitung</li>\n        </ul>\n        <a href=\"#kontakt\" class=\"btn-pill-dark\">\n          <span>Lohnschnitt anfragen</span>\n          <svg class=\"w-3.5 h-3.5 text-[#E31936]\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n            <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.5\" d=\"M14 5l7 7m0 0l-7 7m7-7H3\"/>\n          </svg>\n        </a>\n      </div>\n    </div>\n\n    <!-- 4. Maurer- & Betonarbeiten -->\n    <div class=\"grid grid-cols-1 lg:grid-cols-12 gap-10 items-center\">\n      <div class=\"lg:col-span-6 lg:order-2\">\n        <div class=\"relative aspect-[16/10] rounded-[28px] overflow-hidden bg-[#EAE5D9] group\">\n          <img \n            src=\"https://bau-mueller.eu/wp-content/uploads/2022/04/Sichtmauerwerk-Röhrsdorf.jpeg\" \n            alt=\"Maurer- & Betonarbeiten\" \n            class=\"w-full h-full object-cover group-hover:scale-105 transition-transform duration-700\"\n          >\n          <div class=\"action-circle-badge\">\n            <svg class=\"w-4 h-4 text-[#E31936]\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\">\n              <line x1=\"12\" y1=\"5\" x2=\"12\" y2=\"19\"></line>\n              <line x1=\"5\" y1=\"12\" x2=\"19\" y2=\"12\"></line>\n            </svg>\n          </div>\n        </div>\n      </div>\n      <div class=\"lg:col-span-6 lg:order-1 lg:pr-6\">\n        <span class=\"text-xs font-semibold tracking-wider text-[#E31936] uppercase block mb-2\">Gewerk 04</span>\n        <h2 class=\"font-heading font-bold text-3xl text-[#1A1918] mb-4\">Maurer-, Beton- & Massivbauarbeiten</h2>\n        <p class=\"text-[#6E6963] text-base leading-relaxed mb-4\">\n          Das feste Fundament für Ihr Bauwerk. Wir gießen Bodenplatten, mauern tragende Wände, führen Klinker- und Natursteinarbeiten aus und sanieren historische Kirchenmauern und Altbaufassaden nach Denkmalschutzstandards.\n        </p>\n        <ul class=\"text-xs font-semibold text-[#4A4641] space-y-2 mb-6 uppercase tracking-wider\">\n          <li>✓ Fundamente & Stahlbeton-Bodenplatten</li>\n          <li>✓ Sichtmauerwerk & Klinkerfassaden</li>\n          <li>✓ Denkmalgerechte Putz- un