          "id": "html_post-2218",
          "elType": "widget",
          "widgetType": "html",
          "settings": {
            "html": "<!-- SOMERVILLE ARCHITECTURAL CRAFT DESIGN: Wärme mit Stil – Unsere Pellets für Ihren Kamin -->\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link href=\"https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Inter:wght@400;500;600&display=swap\" rel=\"stylesheet\">\n<script src=\"https://cdn.tailwindcss.com\"></script>\n<script>\n  tailwind.config = {\n    theme: {\n      extend: {\n        fontFamily: {\n          heading: ['\"Plus Jakarta Sans\"', 'sans-serif'],\n          sans: ['Inter', 'sans-serif']\n        },\n        colors: {\n          cream: '#F8F5EE',\n          charcoal: '#1C1B1A',\n          'charcoal-card': '#242321',\n          muted: '#6E6963',\n          'muted-dark': '#A39E93',\n          'text-primary': '#1A1918',\n          'text-secondary': '#4A4641'\n        }\n      }\n    }\n  }\n</script>\n<style>\n\n\n/* Critical Somerville Color Fallbacks */\n.bg-charcoal, footer#kontakt {\n  background-color: #1C1B1A !important;\n  color: #F8F5EE !important;\n}\n.text-cream {\n  color: #F8F5EE !important;\n}\n.bg-charcoal-card {\n  background-color: #242321 !important;\n}\n.bg-cream {\n  background-color: #F8F5EE !important;\n}\nfooter#kontakt h2, footer#kontakt h3, footer#kontakt h4 {\n  color: #FFFFFF !important;\n}\nfooter#kontakt p, footer#kontakt span, footer#kontakt li, footer#kontakt label {\n  color: #E2DDD5;\n}\nfooter#kontakt .btn-pill-light {\n  background-color: #FFFFFF !important;\n  color: #1C1B1A !important;\n}\n</style>\n\n<div class=\"somerville-container w-full bg-[#F8F5EE] text-[#1A1918] antialiased\" style=\"font-family: 'Inter', sans-serif;\">\n<!DOCTYP\n  <!-- ARTICLE CONTENT (SOMERVILLE CRAFT EDITORIAL) -->\n  <main class=\"pt-10 pb-20\">\n    <div class=\"max-w-[1040px] mx-auto px-6\">\n      \n      <!-- Back Link & Breadcrumb -->\n      <div class=\"mb-8 flex items-center justify-between\">\n        <a href=\"/aktuelles/\" class=\"inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-[#6E6963] hover:text-[#E31936] transition-colors\">\n          <svg class=\"w-4 h-4\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n            <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M10 19l-7-7m0 0l7-7m-7 7h18\"/>\n          </svg>\n          <span>Zurück zur Magazin-Übersicht</span>\n        </a>\n        <span class=\"text-xs text-[#A39E93]\">Brennstoffe ab Werk · 20. August 2023</span>\n      </div>\n\n      <!-- Article Header -->\n      <header class=\"mb-10\">\n        <div class=\"inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#E31936]/10 text-[#E31936] text-xs font-bold uppercase tracking-wider mb-4\">\n          <span class=\"w-2 h-2 rounded-full bg-[#E31936]\"></span>\n          100 % Regionaler Kreislauf\n        </div>\n        <h1 class=\"font-heading font-extrabold text-3xl sm:text-5xl text-[#1A1918] tracking-tight leading-tight mb-6\">\n          Wärme mit Stil – Unsere Pellets für Ihren Kamin\n        </h1>\n        <p class=\"text-lg sm:text-xl text-[#4A4641] leading-relaxed font-light\">\n          Heizen Sie Ihr Zuhause effizient, krisensicher und CO2-neutral mit hochwertigen Holzpellets und Holzbriketts direkt aus der Colditzer Meisterwerkstatt. 100 % naturbelassen, ohne chemische Bindemittel.\n        </p>\n      </header>\n\n      <!-- Featured Image Banner -->\n      <div class=\"relative rounded-[32px] overflow-hidden aspect-[21/9] mb-12 shadow-lg bg-[#EAE5D9]\">\n        <img \n          src=\"https://bau-mueller.eu/wp-content/uploads/2025/08/Tor-Zimmerei-Mueller.jpeg\" \n          alt=\"Wärme mit Stil – Unsere Pellets für Ihren Kamin\" \n          class=\"w-full h-full object-cover\"\n        >\n        <div class=\"absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent\"></div>\n        <div class=\"absolute bottom-6 left-6 right-6 text-white text-xs flex justify-between items-end\">\n          <span>Holzlager & Pelletproduktion Werk Colditz · Arthur Müller e.K.</span>\n          <span class=\"bg-black/40 backdrop-blur px-3 py-1 rounded-full\">Brennstoffe ab Werk</span>\n        </div>\n      </div>\n\n      <!-- Editorial Article Content -->\n      <div class=\"bg-white rounded-[32px] p-8 sm:p-12 border border-[#1A1918]/10 shadow-sm space-y-8 text-base text-[#3A3632] leading-relaxed\">\n        \n        <div>\n          <h2 class=\"font-heading font-bold text-2xl text-[#1A1918] mb-3 pb-2 border-b border-[#1A1918]/10\">\n            Der geschlossene Holzkreislauf in Colditz\n          </h2>\n          <p class=\"text-[#4A4641] leading-relaxed mb-4\">\n            Nachhaltigkeit ist bei uns kein Modewort, sondern jahrzehntelange Praxis: Sägespäne und Resthölzer, die bei unserem Lohnschnitt und dem Abbund im Sägewerk anfallen, verarbeiten wir direkt vor Ort zu hochkalorischen Pellets und Briketts. Kein Baum wird eigens für Brennstoff gefällt – 100 % regionale Verwertung.\n          </p>\n        </div>\n\n        <div>\n          <h2 class=\"font-heading font-bold text-2xl text-[#1A1918] mb-3 pb-2 border-b border-[#1A1918]/10\">\n            Höchste Heizwerte nach ENplus A1 Standard\n          </h2>\n          <p class=\"text-[#4A4641] leading-relaxed mb-4\">\n            Durch den extrem niedrigen Restfeuchtegehalt von unter 8 % erzielen unsere Holzpellets eine saubere, aschearme Verbrennung bei maximalem Wirkungsgrad. Das schont Ihre Heizungsanlage, Ihren Kaminofen und die Umwelt gleichermaßen.\n          </p>\n        </div>\n\n        <div>\n          <h2 class=\"font-heading font-bold text-2xl text-[#1A1918] mb-3 pb-2 border-b border-[#1A1918]/10\">\n            Abholung ab Werk oder bequeme Palettenlieferung\n          </h2>\n          <p class=\"text-[#4A4641] leading-relaxed mb-4\">\n            Sie können Pellets und Holzbriketts während unserer Öffnungszeiten (Mo–Fr 08:00–15:30 Uhr) direkt bei uns in der Geithainer Str. 32 in Colditz säckeweise abholen oder größere Mengen bequem auf Palette anliefern lassen. Sprechen Sie uns für tagesaktuelle Staffelpreise an.\n          </p>\n        </div>\n\n\n        <!-- Pull-Quote -->\n        <div class=\"p-8 rounded-2xl bg-charcoal text-[#FFFCF5] my-8 relative overflow-hidden\">\n          <div class=\"text-4xl text-[#E31936] font-serif mb-2\">„</div>\n          <blockquote class=\"font-heading font-bold text-lg sm:text-xl leading-snug mb-4\">\n            Aus unseren Hobelspänen wird wohlige Kaminwärme. So schließen wir den Kreislauf unseres Sägewerks vom Stamm bis zum Brennstoff.\n          </blockquote>\n          <cite class=\"text-xs text-[#A39E93] not-italic block uppercase tracking-wider\">\n            — Dipl.-Ing. Tobias Müller · Inhaber, Arthur Müller e.K.\n          </cite>\n        </div>\n\n        <!-- Call to Action -->\n        <div class=\"pt-8 border-t border-[#1A1918]/10 flex flex-col sm:flex-row items-center justify-between gap-6\">\n          <div>\n            <h4 class=\"font-heading font-bold text-lg text-[#1A1918]\">Haben Sie Fragen zu diesem Thema?</h4>\n            <p class=\"text-xs text-[#6E6963] mt-1\">Sprechen Sie direkt mit Zimmermeister Tobias Müller.</p>\n          </div>\n          <a href=\"#kontakt\" class=\"btn-pill-dark shrink-0\">\n            <span>Projekt anfragen</span>\n            <svg class=\"w-3.5 h-3.5 text-[#E31936]\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n              <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.5\" d=\"M14 5l7 7m0 0l-7 7m7-7H3\"/>\n            </svg>\n          </a>\n        </div>\n\n      </div>\n\n    </div>\n  </main>\n  <!-- 7. FOOTER (SOMERVILLE STYLE ARCHITECTURAL SLAB) -->\n    <!-- 7. FOOTER (SOMERVILLE STYLE ARCHITECTURAL SLAB) -->\n  <footer id=\"kontakt\" class=\"bg-charcoal text-cream pt-20 pb-12 rounded-t-[40px]\">\n    <div class=\"max-w-[1340px] mx-auto px-6 lg:px-10\">\n      \n      <!-- Contact Header & Interactive Inquiry Form -->\n      <div class=\"pb-16 border-b border-white/10\">\n        <div class=\"grid grid-cols-1 lg:grid-cols-12 gap-12 items-start\">\n          \n          <!-- Left Column: Intro & Direct Contact Badges -->\n          <div class=\"lg:col-span-5\">\n            <span class=\"text-xs font-semibold tracking-widest text-[#E31936] uppercase block mb-3\">\n              Kontakt & Vorhaben besprechen\n            </span>\n            <h2 class=\"font-heading font-bold text-3xl sm:text-4xl text-[#FFFCF5] leading-tight mb-6\">\n              Bereit für Ihr nächstes Bauvorhaben? Sprechen Sie mit uns.\n            </h2>\n            <p class=\"text-sm sm:text-base text-[#A39E93] leading-relaxed mb-8\">\n              Ob traditioneller Dachstuhl, maßgefertigte Treppe, Lohnschnitt im Sägewerk oder Gesamtsanierung – Meister Tobias Müller und unser Team beraten Sie persönlich, verlässlich und fachgerecht.\n            </p>\n\n            <div class=\"space-y-4\">\n              <a href=\"tel:+493438143336\" class=\"flex items-center gap-4 p-4 rounded-2xl bg-white/5 hover:bg-white/10 border border-white/10 transition-all group\">\n                <div class=\"w-12 h-12 rounded-xl bg-[#E31936] flex items-center justify-center text-white shrink-0 group-hover:scale-105 transition-transform\">\n                  <svg class=\"w-5 h-5\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n                    <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z\"/>\n                  </svg>\n                </div>\n                <div>\n                  <span class=\"text-xs text-[#A39E93] uppercase tracking-wider block\">Telefonische Direktberatung</span>\n                  <span class=\"text-base font-bold text-white group-hover:text-[#E31936] transition-colors\">034381-43336 anrufen</span>\n                </div>\n              </a>\n\n              <a href=\"mailto:info@bau-mueller.eu\" class=\"flex items-center gap-4 p-4 rounded-2xl bg-white/5 hover:bg-white/10 border border-white/10 transition-all group\">\n                <div class=\"w-12 h-12 rounded-xl bg-white/10 flex items-center justify-center text-white shrink-0 group-hover:bg-[#E31936] transition-colors\">\n                  <svg class=\"w-5 h-5\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n                    <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z\"/>\n                  </svg>\n                </div>\n                <div>\n                  <span class=\"text-xs text-[#A39E93] uppercase tracking-wider block\">E-Mail für Pläne & Anfragen</span>\n                  <span class=\"text-base font-bold text-white group-hover:text-[#E31936] transition-colors\">info@bau-mueller.eu</span>\n                </div>\n              </a>\n            </div>\n\n            <div class=\"mt-8 pt-6 border-t border-white/10 flex items-center gap-4 text-xs text-[#A39E93]\">\n              <span>✓ Schnelle Rückmeldung</span>\n              <span>•</span>\n              <span>✓ Meisterbetrieb seit 1920</span>\n              <span>•</span>\n              <span>✓ Kostenfreie Erstberatung</span>\n            </div>\n          </div>\n\n          <!-- Right Column: Interactive Somerville Inquiry Form -->\n          <div class=\"lg:col-span-7 bg-[#242321] rounded-[28px] p-6 sm:p-8 border border-white/10 shadow-2xl\">\n            <h3 class=\"font-heading font-bold text-xl text-white mb-1.5\">Schnellanfrage stellen</h3>\n            <p class=\"text-xs text-[#A39E93] mb-6\">Füllen Sie kurz die Eckdaten aus – wir melden uns umgehend bei Ihnen zurück.</p>\n            \n            <form id=\"somerville-quick-inquiry\" class=\"space-y-4\" onsubmit=\"event.preventDefault(); submitInquiryForm(this);\">\n              <div class=\"grid grid-cols-1 sm:grid-cols-2 gap-4\">\n                <div>\n                  <label class=\"block text-xs font-semibold text-[#FFFCF5]/80 uppercase tracking-wider mb-1.5\">Ihr Name *</label>\n                  <input type=\"text\" name=\"name\" required placeholder=\"Vor- und Nachname\" class=\"w-full px-4 py-3 rounded-xl bg-white/5 border border-white/15 text-white placeholder-white/40 text-sm focus:outline-none focus:border-[#E31936] transition-colors\">\n                </div>\n                <div>\n                  <label class=\"block text-xs font-semibold text-[#FFFCF5]/80 uppercase tracking-wider mb-1.5\">Telefon / Mobil *</label>\n                  <input type=\"tel\" name=\"phone\" required placeholder=\"z. B. 0172 1234567\" class=\"w-full px-4 py-3 rounded-xl bg-white/5 border border-white/15 text-white placeholder-white/40 text-sm focus:outline-none focus:border-[#E31936] transition-colors\">\n                </div>\n              </div>\n\n              <div class=\"grid grid-cols-1 sm:grid-cols-2 gap-4\">\n                <div>\n                  <label class=\"block text-xs font-semibold text-[#FFFCF5]/80 uppercase tracking-wider mb-1.5\">E-Mail-Adresse *</label>\n                  <input type=\"email\" name=\"email\" required placeholder=\"ihre-adresse@beispiel.de\" class=\"w-full px-4 py-3 rounded-xl bg-white/5 border border-white/15 text-white placeholder-white/40 text-sm focus:outline-none focus:border-[#E31936] transition-colors\">\n                </div>\n                <div>\n                  <label class=\"block text-xs font-semibold text-[#FFFCF5]/80 uppercase tracking-wider mb-1.5\">Gewerk / Vorhaben</label>\n                  <select name=\"gewerk\" class=\"w-full px-4 py-3 rounded-xl bg-[#2C2B28] border border-white/15 text-white text-sm focus:outline-none focus:border-[#E31936] transition-colors\">\n                    <option value=\"Zimmerei & Dachstuhl\">Zimmerei & Dachstuhl</option>\n                    <option value=\"Treppen- & Möbelbau\">Treppen- & Möbelbau</option>\n                    <option value=\"Sägewerk & Lohnschnitt\">Sägewerk & Lohnschnitt</option>\n                    <option value=\"Maurer- & Massivbauarbeiten\">Maurer- & Massivbauarbeiten</option>\n                    <option value=\"Pellets & Brennstoffe\">Pellets & Holzbriketts</option>\n                    <option value=\"Allgemeine Anfrage\">Sonstiges / Vor-Ort-Termin</option>\n                  </select>\n                </div>\n              </div>\n\n              <div>\n                <label class=\"block text-xs font-semibold text-[#FFFCF5]/80 uppercase tracking-wider mb-1.5\">Kurze Beschreibung Ihres Vorhabens</label>\n                <textarea name=\"message\" rows=\"3\" placeholder=\"Maße, Standort, Zeitrahmen oder sonstige Details...\" class=\"w-full px-4 py-3 rounded-xl bg-white/5 border border-white/15 text-white placeholder-white/40 text-sm focus:outline-none focus:border-[#E31936] transition-colors\"></textarea>\n              </div>\n\n              <div class=\"flex items-start gap-2.5 pt-1\">\n                <input type=\"checkbox\" id=\"dsgvo-consent\" required class=\"mt-1 rounded bg-white/10 border-white/20 text-[#E31936] focus:ring-[#E31936]\">\n                <label for=\"dsgvo-consent\" class=\"text-xs text-[#A39E93] leading-snug\">\n                  Ich willige ein, dass meine Angaben zur Kontaktaufnahme und Zuordnung meiner Anfrage verarbeitet werden. Details in der <a href=\"/datenschutz/\" class=\"underline text-white hover:text-[#E31936]\">Datenschutzerklärung</a>.\n                </label>\n              </div>\n\n              <div id=\"inquiry-form-status\" class=\"hidden text-xs py-3 px-4 rounded-xl\"></div>\n\n              <button type=\"submit\" class=\"w-full btn-pill-light justify-center text-sm py-3.5 bg-[#E31936] hover:bg-[#c9142e] text-white border-none shadow-lg\">\n                <span>Unverbindliche Anfrage absenden</span>\n                <svg class=\"w-4 h-4 text-white\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n                  <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.5\" d=\"M14 5l7 7m0 0l-7 7m7-7H3\"/>\n                </svg>\n              </button>\n            </form>\n          </div>\n\n        </div>\n      </div>\n\n      <!-- Offizieller Fördermittelhinweis (SAB & EU / EFRE) -->\n      <div class=\"my-12 p-6 sm:p-8 rounded-[24px] bg-white text-[#1A1918] shadow-2xl border border-white/20\">\n        <div class=\"flex flex-col lg:flex-row items-center justify-between gap-8\">\n          <!-- Offizielles Signet: EU & Freistaat Sachsen -->\n          <div class=\"w-full lg:w-5/12 flex-shrink-0 flex items-center justify-center lg:justify-start\">\n            <img \n              src=\"https://bau-mueller.eu/wp-content/uploads/2026/03/EFRE-ESF_LO_Kombination_EU-Logo_SachsenSignet-klassisch_HF_RGB_300dpi.jpg\" \n              alt=\"Kofinanziert von der Europäischen Union und dem Freistaat Sachsen – Sächsische Aufbaubank (SAB)\" \n              class=\"max-w-full h-auto max-h-[85px] object-contain\"\n              loading=\"lazy\"\n            >\n          </div>\n          \n          <!-- Fördertext & Button -->\n          <div class=\"w-full lg:w-7/12 flex flex-col sm:flex-row sm:items-center justify-between gap-6\">\n            <p class=\"text-sm sm:text-[15px] italic text-[#3A3632] leading-relaxed\">\n              „Unser Projekt <strong>„Werkstatt der Zukunft – Präzision trifft Tradition“</strong> wird durch die Europäische Union und den Freistaat Sachsen unterstützt. Die Maßnahme wird über die Sächsische Aufbaubank (SAB) gefördert.“\n            </p>\n            <a \n              href=\"/werkstatt-der-zukunft-praezision-trifft-tradition/\" \n              class=\"inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-full bg-[#2563EB] hover:bg-[#1D4ED8] text-white font-medium text-sm transition-all duration-200 shrink-0 shadow-md hover:shadow-lg\"\n            >\n              <span>Hier geht es zum Artikel</span>\n              <svg class=\"w-4 h-4 text-white\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n                <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M14 5l7 7m0 0l-7 7m7-7H3\"/>\n              </svg>\n            </a>\n          </div>\n        </div>\n      </div>\n\n      <!-- Navigation & Info Columns -->\n      <div class=\"grid grid-cols-1 md:grid-cols-4 gap-10 py-16 text-sm\">\n        <div>\n          <h4 class=\"font-heading font-bold text-white text-base mb-4 uppercase tracking-wider text-xs\">Standort</h4>\n          <p class=\"text-muted-dark leading-relaxed\">\n            Zimmerei & Baugeschäft Arthur Müller e.K.<br>\n            Geithainer Str. 32<br>\n            04680 Colditz<br>\n            Inhaber: Dipl.-Ing. Tobias Müller\n          </p>\n        </div>\n        <div>\n          <h4 class=\"font-heading font-bold text-white text-base mb-4 uppercase tracking-wider text-xs\">Gewerke</h4>\n          <ul class=\"space-y-2.5 text-muted-dark\">\n            <li><a href=\"/leistungen/\" class=\"hover:text-white transition-colors\">Zimmerei & Holzbau</a></li>\n            <li><a href=\"/leistungen/\" class=\"hover:text-white transition-colors\">Treppen- & Möbelbau</a></li>\n            <li><a href=\"/leistungen/\" class=\"hover:text-white transition-colors\">Maurer- & Betonarbeiten</a></li>\n            <li><a href=\"/leistungen/\" class=\"hover:text-white transition-colors\">Altbausanierung & Denkmal</a></li>\n            <li><a href=\"/leistungen/\" class=\"hover:text-white transition-colors\">Pellets & Holzbriketts</a></li>\n          </ul>\n        </div>\n        <div>\n          <h4 class=\"font-heading font-bold text-white text-base mb-4 uppercase tracking-wider text-xs\">Öffnungszeiten</h4>\n          <p class=\"text-muted-dark leading-relaxed\">\n            Montag – Freitag: 08:00 – 15:30 Uhr<br>\n            Pellet-Verkauf & Abholung ab Werk.<br>\n            Telefon: 034381-43336\n          </p>\n        </div>\n        <div>\n          <h4 class=\"font-heading font-bold text-white text-base mb-4 uppercase tracking-wider text-xs\">Aktuelles & Magazin</h4>\n          <ul class=\"space-y-2.5 text-muted-dark\">\n            <li><a href=\"/aktuelles/\" class=\"hover:text-white transition-colors\">Werkstatt & Sägewerk</a></li>\n            <li><a href=\"/aktuelles/\" class=\"hover:text-white transition-colors\">Pellet-Verfügbarkeit</a></li>\n            <li><a href=\"/werkstatt-der-zukunft-praezision-trifft-tradition/\" class=\"hover:text-white transition-colors\">SAB-Förderprojekt</a></li>\n          </ul>\n        </div>\n      </div>\n\n      <!-- Bottom Bar & Copyright -->\n      <div class=\"pt-8 border-t border-white/10 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-muted-dark\">\n        <p>© 2026 Arthur Müller e.K. · Meisterbetrieb seit 1920</p>\n        <div class=\"flex items-center gap-6\">\n          <a href=\"/impressum/\" class=\"hover:text-white transition-colors\">Impressum</a>\n          <a href=\"/datenschutz/\" class=\"hover:text-white transition-colors\">Datenschutz</a>\n          <a href=\"#\" class=\"hover:text-white transition-colors\">Cookie-Einstellungen</a>\n        </div>\n      </div>\n\n    </div>\n  </footer>\n\n  <!-- FEEDBACK / VOTING POPUP (ERSCHEINT NACH 8 SEKUNDEN) -->\n  <aside id=\"feedback-voting-popup\" aria-label=\"Feedback zur neuen Website\" class=\"fixed bottom-6 right-6 z-50 max-w-sm w-[calc(100%-3rem)] sm:w-96 bg-[#1C1B1A]/95 text-[#F8F5EE] backdrop-blur-lg rounded-[24px] p-6 shadow-2xl border border-white/15 transform translate-y-20 opacity-0 pointer-events-none transition-all duration-500 ease-out\">\n    \n    <!-- Close Button -->\n    <button id=\"feedback-popup-close\" class=\"absolute top-4 right-4 w-7 h-7 rounded-full bg-white/10 hover:bg-white/20 flex items-center justify-center text-white/70 hover:text-white transition-colors focus:outline-none\" aria-label=\"Feedback-Fenster schließen\">\n      <svg class=\"w-3.5 h-3.5\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n        <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M6 18L18 6M6 6l12 12\"/>\n      </svg>\n    </button>\n\n    <!-- Initial State -->\n    <div id=\"voting-initial-state\">\n      <div class=\"flex items-center gap-2 mb-2\">\n        <span class=\"w-2 h-2 rounded-full bg-[#E31936] animate-pulse\"></span>\n        <span class=\"text-[11px] font-semibold tracking-wider uppercase text-[#E31936]\">Neuer Webauftritt</span>\n      </div>\n      <h3 class=\"font-heading font-bold text-lg text-white mb-1.5 leading-snug\">\n        Wie gefällt Ihnen unsere neue Website?\n      </h3>\n      <p class=\"text-xs text-[#A39E93] mb-4 leading-relaxed\">\n        Ihre Meinung zählt: Wie gefällt Ihnen das neue Design unseres Meisterbetriebs?\n      </p>\n\n      <div class=\"grid grid-cols-3 gap-2\">\n        <button class=\"vote-btn py-2.5 px-2 rounded-xl bg-white/10 hover:bg-[#E31936] text-white text-xs font-semibold flex flex-col items-center gap-1 transition-all\" data-vote=\"super\">\n          <span class=\"text-base\">😍</span>\n          <span>Begeistert</span>\n        </button>\n        <button class=\"vote-btn py-2.5 px-2 rounded-xl bg-white/10 hover:bg-white/20 text-white text-xs font-semibold flex flex-col items-center gap-1 transition-all\" data-vote=\"gut\">\n          <span class=\"text-base\">👍</span>\n          <span>Sehr gut</span>\n        </button>\n        <button class=\"vote-btn py-2.5 px-2 rounded-xl bg-white/10 hover:bg-white/20 text-white text-xs font-semibold flex flex-col items-center gap-1 transition-all\" data-vote=\"feedback\">\n          <span class=\"text-base\">💬</span>\n          <span>Geht so</span>\n        </button>\n      </div>\n    </div>\n\n    <!-- Thank You State -->\n    <div id=\"voting-thankyou-state\" class=\"hidden py-4 text-center\">\n      <span class=\"text-3xl block mb-2\">🪵✨</span>\n      <h4 class=\"font-heading font-bold text-base text-white mb-1\">Vielen Dank für Ihre Stimme!</h4>\n      <p class=\"text-xs text-[#A39E93]\">Ihr Feedback hilft uns, den Auftritt unseres Meisterbetriebs stetig zu verfeinern.</p>\n    </div>\n\n  </aside>\n\n  <script>\n    // FEEDBACK VOTING POPUP LOGIC (Trigger nach 8 Sekunden & Speicherung auf Server)\n    (function() {\n      var popup = document.getElementById('feedback-voting-popup');\n      if (!popup) return;\n      \n      if (localStorage.getItem('mueller_website_voted') || sessionStorage.getItem('mueller_popup_dismissed')) {\n        return;\n      }\n\n      var closeBtn = document.getElementById('feedback-popup-close');\n      var initialState = document.getElementById('voting-initial-state');\n      var thankYouState = document.getElementById('voting-thankyou-state');\n      var voteBtns = document.querySelectorAll('.vote-btn');\n\n      function showPopup() {\n        popup.classList.remove('translate-y-20', 'opacity-0', 'pointer-events-none');\n        popup.classList.add('translate-y-0', 'opacity-100', 'pointer-events-auto');\n      }\n\n      function hidePopup() {\n        popup.classList.remove('translate-y-0', 'opacity-100', 'pointer-events-auto');\n        popup.classList.add('translate-y-20', 'opacity-0', 'pointer-events-none');\n      }\n\n      setTimeout(showPopup, 8000);\n\n      if (closeBtn) {\n        closeBtn.addEventListener('click', function() {\n          hidePopup();\n          sessionStorage.setItem('mueller_popup_dismissed', 'true');\n        });\n      }\n\n      voteBtns.forEach(function(btn) {\n        btn.addEventListener('click', function() {\n          var vote = btn.getAttribute('data-vote');\n          localStorage.setItem('mueller_website_voted', vote);\n          \n          try {\n            fetch('/wp-content/vote_collector.php', {\n              method: 'POST',\n              headers: { 'Content-Type': 'application/json' },\n              body: JSON.stringify({\n                vote: vote,\n                url: window.location.pathname\n              })\n            }).catch(function(e) { console.log('Vote logging error:', e); });\n          } catch(e) {}\n          \n          if (initialState && thankYouState) {\n            initialState.classList.add('hidden');\n            thankYouState.classList.remove('hidden');\n          }\n          \n          setTimeout(hidePopup, 3000);\n        });\n      });\n    })();\n\n    // SCHNELLANFRAGE-FORMULAR LOGIC\n    function submitInquiryForm(form) {\n      var statusBox = document.getElementById('inquiry-form-status');\n      var formData = new FormData(form);\n      var name = formData.get('name') || '';\n      var phone = formData.get('phone') || '';\n      var email = formData.get('email') || '';\n      var gewerk = formData.get('gewerk') || '';\n      var msg = formData.get('message') || '';\n\n      if (statusBox) {\n        statusBox.className = 'text-xs py-3 px-4 rounded-xl bg-emerald-900/60 border border-emerald-500 text-emerald-100 block mb-4';\n        statusBox.innerHTML = '<strong>Vielen Dank, ' + name + '!</strong> Ihre Anfrage zum Bereich <em>' + gewerk + '</em> wurde aufgenommen. Meister Tobias Müller meldet sich in Kürze unter ' + phone + ' bei Ihnen.';\n      }\n      form.reset();\n    }\n  </script>\n\n\n\n</div>\n"
          }
        }
