Headline -->\n      <div class=\"pb-16 border-b border-white/10 flex flex-col md:flex-row md:items-end justify-between gap-8\">\n        <div class=\"max-w-2xl\">\n          <span class=\"text-xs font-semibold tracking-widest text-[#E31936] uppercase block mb-3\">\n            Kontakt & Vorhaben besprechen\n          </span>\n          <h2 class=\"font-heading font-bold text-3xl sm:text-5xl text-[#FFFCF5] leading-tight\">\n            Bereit für Ihr nächstes Bauvorhaben? Sprechen Sie mit uns.\n          </h2>\n        </div>\n        <div>\n          <a href=\"tel:+493438143336\" class=\"btn-pill-light text-base\">\n            <span>034381-43336 anrufen</span>\n            <svg class=\"w-4 h-4 text-[#1C1B1A]\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n              <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.5\" d=\"M14 5l7 7m0 0l-7 7m7-7H3\"/>\n            </svg>\n          </a>\n        </div>\n      </div>\n\n      <!-- Offizieller Fördermittelhinweis (SAB & EU / EFRE) -->\n      <div class=\"my-12 p-6 sm:p-8 rounded-[24px] bg-white text-[#1A1918] shadow-2xl border border-white/20\">\n        <div class=\"flex flex-col lg:flex-row items-center justify-between gap-8\">\n          <!-- Offizielles Signet: EU & Freistaat Sachsen -->\n          <div class=\"w-full lg:w-5/12 flex-shrink-0 flex items-center justify-center lg:justify-start\">\n            <img \n              src=\"https://bau-mueller.eu/wp-content/uploads/2026/03/EFRE-ESF_LO_Kombination_EU-Logo_SachsenSignet-klassisch_HF_RGB_300dpi.jpg\" \n              alt=\"Kofinanziert von der Europäischen Union und dem Freistaat Sachsen – Sächsische Aufbaubank (SAB)\" \n              class=\"max-w-full h-auto max-h-[85px] object-contain\"\n              loading=\"lazy\"\n            >\n          </div>\n          \n          <!-- Fördertext & Button -->\n          <div class=\"w-full lg:w-7/12 flex flex-col sm:flex-row sm:items-center justify-between gap-6\">\n    