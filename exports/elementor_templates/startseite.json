          "id": "html_startseite",
          "elType": "widget",
          "widgetType": "html",
          "settings": {
            "html": "<!-- SOMERVILLE ARCHITECTURAL CRAFT DESIGN: NEU – Startseite -->\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link href=\"https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Inter:wght@400;500;600&display=swap\" rel=\"stylesheet\">\n<script src=\"https://cdn.tailwindcss.com\"></script>\n<style>\nbody {\n      font-family: 'Inter', sans-serif;\n      background-color: #F8F5EE;\n      color: #1A1918;\n      -webkit-font-smoothing: antialiased;\n    }\n    h1, h2, h3, h4, .font-heading {\n      font-family: 'Plus Jakarta Sans', sans-serif;\n      letter-spacing: -0.028em;\n    }\n    .bg-cream { background-color: #F8F5EE; }\n    .bg-cream-card { background-color: #F3EFE6; }\n    .bg-charcoal { background-color: #1C1B1A; }\n    .bg-charcoal-card { background-color: #262523; }\n    .text-charcoal { color: #1A1918; }\n    .text-cream { color: #FAF7F2; }\n    .text-muted-editorial { color: #6E6963; }\n    .text-muted-dark { color: #9C968F; }\n    .accent-red { color: #E31936; }\n    .bg-accent-red { background-color: #E31936; }\n\n    /* Pill Button Styles */\n    .btn-pill-dark {\n      background-color: #1C1B1A;\n      color: #FAF7F2;\n      border-radius: 9999px;\n      padding: 12px 26px;\n      font-size: 14px;\n      font-weight: 600;\n      display: inline-flex;\n      align-items: center;\n      gap: 10px;\n      transition: all 0.25s ease;\n    }\n    .btn-pill-dark:hover {\n      background-color: #2F2E2C;\n      transform: translateY(-1px);\n    }\n    .btn-pill-light {\n      background-color: #FAF7F2;\n      color: #1C1B1A;\n      border-radius: 9999px;\n      padding: 12px 26px;\n      font-size: 14px;\n      font-weight: 600;\n      display: inline-flex;\n      align-items: center;\n      gap: 10px;\n      transition: all 0.25s ease;\n    }\n    .btn-pill-light:hover {\n      background-color: #FFFFFF;\n      transform: translateY(-1px);\n    }\n\n    /* Floating Circle Action Badge */\n    .action-circle-badge {\n      position: absolute;\n      bottom: 16px;\n      right: 16px;\n      width: 44px;\n      height: 44px;\n      background-color: #FFFFFF;\n      border-radius: 50%;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      box-shadow: 0 4px 14px rgba(0, 0, 0, 0.14);\n      transition: transform 0.3s ease, background-color 0.3s ease;\n    }\n    .group:hover .action-circle-badge {\n      transform: scale(1.1);\n      background-color: #FAF7F2;\n    }\n    \n    /* Underline hover like Somerville */\n    .editorial-link-hover {\n      background-image: linear-gradient(currentColor, currentColor);\n      background-position: 0% 100%;\n      background-repeat: no-repeat;\n      background-size: 0% 2px;\n      transition: background-size .3s ease;\n    }\n    .group:hover .editorial-link-hover {\n      background-size: 100% 2px;\n    }\n\n    /* Cinematic Ken Burns Zoom Animation for Hero Tor */\n    @keyframes kenBurnsZoom {\n      0% {\n        transform: scale(1.0);\n      }\n      50% {\n        transform: scale(1.10);\n      }\n      100% {\n        transform: scale(1.0);\n      }\n    }\n    .animate-hero-tor {\n      animation: kenBurnsZoom 20s ease-in-out infinite alternate;\n      transform-origin: center 40%;\n      will-change: transform;\n    }\n</style>\n\n<div class=\"somerville-container w-full bg-[#F8F5EE] text-[#1A1918] antialiased\" style=\"font-family: 'Inter', sans-serif;\">\n<!-- TOP HEADER (MINIMALIST, ARCHITECTURAL SOMERVILLE) -->\n  <header class=\"sticky top-0 z-50 bg-[#F8F5EE]/95 backdrop-blur-md border-b border-[#E8E3D8] transition-all\">\n    <div class=\"max-w-[1400px] mx-auto px-4 sm:px-6 py-4 flex items-center justify-between\">\n      \n      <!-- Left: Mobile Menu Toggle Button & Desktop Nav -->\n      <div class=\"flex items-center gap-6 sm:gap-8\">\n        <button id=\"menu-toggle-btn\" class=\"flex items-center gap-2.5 text-xs font-semibold tracking-wider uppercase text-[#1A1918] hover:text-[#E31936] transition-colors focus:outline-none\" aria-label=\"Menü öffnen\">\n          <span class=\"w-5 flex flex-col gap-1\">\n            <span class=\"block w-5 h-0.5 bg-current transition-all\"></span>\n            <span class=\"block w-3.5 h-0.5 bg-current transition-all\"></span>\n          </span>\n          <span class=\"inline\">Menü</span>\n        </button>\n        <nav class=\"hidden lg:flex items-center gap-7 text-sm font-medium text-[#4A4641]\">\n          <a href=\"/leistungen/\" class=\"hover:text-[#1A1918] transition-colors\">Leistungen</a>\n          <a href=\"#werkstatt\" class=\"hover:text-[#1A1918] transition-colors\">Werkstatt & Sägewerk</a>\n          <a href=\"/projects/\" class=\"hover:text-[#1A1918] transition-colors\">Referenzen</a>\n          <a href=\"#nachhaltigkeit\" class=\"hover:text-[#1A1918] transition-colors flex items-center gap-1.5\">\n            Pellets <span class=\"text-[10px] font-bold px-1.5 py-0.5 rounded-full bg-[#E31936] text-white\">Öko</span>\n          </a>\n          <a href=\"/about/\" class=\"hover:text-[#1A1918] transition-colors\">Über uns</a>\n        </nav>\n      </div>\n\n      <!-- Center: Architectural Brand Identity -->\n      <div class=\"text-center\">\n        <a href=\"/\" class=\"inline-block\">\n          <span class=\"block font-heading font-extrabold text-lg sm:text-xl md:text-2xl tracking-tight text-[#1A1918] uppercase\">\n            Arthur Müller\n          </span>\n          <span class=\"block text-[9px] sm:text-[10px] tracking-[0.25em] uppercase text-[#7A756E] font-medium mt-0.5\">\n            Zimmerei & Baugeschäft · Seit 1920\n          </span>\n        </a>\n      </div>\n\n      <!-- Right: Direct Phone CTA & Project Button -->\n      <div class=\"flex items-center gap-3 sm:gap-4\">\n        <a href=\"tel:+493438143336\" class=\"hidden sm:inline-block text-xs font-semibold text-[#4A4641] hover:text-[#1A1918] transition-colors\">\n          034381 43336\n        </a>\n        <a href=\"#kontakt\" class=\"btn-pill-dark text-xs sm:text-sm\">\n          <span>Projekt anfragen</span>\n          <svg class=\"w-3.5 h-3.5 text-[#E31936]\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n            <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.5\" d=\"M14 5l7 7m0 0l-7 7m7-7H3\"/>\n          </svg>\n        </a>\n      </div>\n    </div>\n  </header>\n\n  <!-- MOBILE / OFF-CANVAS NAVIGATION DRAWER -->\n  <div id=\"mobile-menu-drawer\" class=\"fixed inset-0 z-[100] transition-opacity duration-300 opacity-0 pointer-events-none\" aria-hidden=\"true\">\n    <div id=\"mobile-menu-backdrop\" class=\"absolute inset-0 bg-[#1C1B1A]/80 backdrop-blur-md\"></div>\n    <div id=\"mobile-menu-panel\" class=\"absolute top-0 left-0 bottom-0 w-full max-w-sm sm:max-w-md bg-[#1C1B1A] text-[#F8F5EE] shadow-2xl flex flex-col justify-between p-6 sm:p-8 transform -translate-x-full transition-transform duration-300 ease-out border-r border-white/10 overflow-y-auto\">\n      <div>\n        <div class=\"flex items-center justify-between pb-6 border-b border-white/10\">\n          <div>\n            <span class=\"block font-heading font-extrabold text-lg tracking-tight uppercase text-white\">\n              Arthur Müller\n            </span>\n            <span class=\"block text-[10px] tracking-[0.2em] uppercase text-[#A39E93] mt-0.5 font-medium\">\n              Zimmerei & Baugeschäft · 1920\n            </span>\n          </div>\n          <button id=\"mobile-menu-close\" class=\"w-10 h-10 rounded-full bg-white/10 hover:bg-white/20 flex items-center justify-center text-white transition-colors focus:outline-none\" aria-label=\"Menü schließen\">\n            <svg class=\"w-5 h-5\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n              <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M6 18L18 6M6 6l12 12\"/>\n            </svg>\n          </button>\n        </div>\n\n        <nav class=\"mt-6 flex flex-col gap-2\">\n          <a href=\"/\" class=\"mobile-nav-link text-base sm:text-lg font-semibold text-white/90 hover:text-white py-2.5 flex items-center justify-between border-b border-white/5 transition-colors\">\n            <span>Startseite</span>\n            <span class=\"text-xs text-[#E31936]\">01</span>\n          </a>\n          <a href=\"/leistungen/\" class=\"mobile-nav-link text-base sm:text-lg font-semibold text-white/90 hover:text-white py-2.5 flex items-center justify-between border-b border-white/5 transition-colors\">\n            <span>Leistungen & Handwerk</span>\n            <span class=\"text-xs text-[#E31936]\">02</span>\n          </a>\n          <a href=\"#werkstatt\" class=\"mobile-nav-link text-base sm:text-lg font-semibold text-white/90 hover:text-white py-2.5 flex items-center justify-between border-b border-white/5 transition-colors\">\n            <span>Werkstatt & Sägewerk</span>\n            <span class=\"text-xs text-[#E31936]\">03</span>\n          </a>\n          <a href=\"/projects/\" class=\"mobile-nav-link text-base sm:text-lg font-semibold text-white/90 hover:text-white py-2.5 flex items-center justify-between border-b border-white/5 transition-colors\">\n            <span>Referenzen & Bauten</span>\n            <span class=\"text-xs text-[#E31936]\">04</span>\n          </a>\n          <a href=\"/about/\" class=\"mobile-nav-link text-base sm:text-lg font-semibold text-white/90 hover:text-white py-2.5 flex items-center justify-between border-b border-white/5 transition-colors\">\n            <span>Über uns (4. Generation)</span>\n            <span class=\"text-xs text-[#E31936]\">05</span>\n          </a>\n          <a href=\"#nachhaltigkeit\" class=\"mobile-nav-link text-base sm:text-lg font-semibold text-white/90 hover:text-white py-2.5 flex items-center justify-between border-b border-white/5 transition-colors\">\n            <span class=\"flex items-center gap-2\">\n              Pellet- & Holzbriketts\n              <span class=\"text-[10px] font-bold px-2 py-0.5 rounded-full bg-[#E31936] text-white\">Öko</span>\n            </span>\n            <span class=\"text-xs text-[#E31936]\">06</span>\n          </a>\n        </nav>\n      </div>\n\n      <div class=\"pt-6 border-t border-white/10 space-y-4 mt-6\">\n        <a href=\"tel:+493438143336\" class=\"w-full py-3 px-4 rounded-full bg-white/10 hover:bg-white/15 text-white flex items-center justify-center gap-2 text-sm font-semibold transition-colors\">\n          <svg class=\"w-4 h-4 text-[#E31936]\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n            <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z\"/>\n          </svg>\n          <span>034381 43336</span>\n        </a>\n        <a href=\"#kontakt\" class=\"btn-pill-light w-full justify-center text-sm py-3 mobile-nav-link\">\n          <span>Projekt anfragen</span>\n          <svg class=\"w-4 h-4 text-[#1C1B1A]\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n            <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.5\" d=\"M14 5l7 7m0 0l-7 7m7-7H3\"/>\n          </svg>\n        </a>\n        <div class=\"text-[11px] text-center text-[#A39E93] leading-relaxed\">\n          Geithainer Str. 32 · 04680 Colditz<br>\n          Mo–Fr: 08:00 – 15:30 Uhr\n        </div>\n      </div>\n    </div>\n  </div>\n\n  <script>\n    (function() {\n      var toggleBtn = document.getElementById('menu-toggle-btn');\n      var drawer = document.getElementById('mobile-menu-drawer');\n      var panel = document.getElementById('mobile-menu-panel');\n      var backdrop = document.getElementById('mobile-menu-backdrop');\n      var closeBtn = document.getElementById('mobile-menu-close');\n      var navLinks = document.querySelectorAll('.mobile-nav-link');\n\n      function openMenu() {\n        if (!drawer) return;\n        drawer.classList.remove('opacity-0', 'pointer-events-none');\n        drawer.classList.add('opacity-100', 'pointer-events-auto');\n        panel.classList.remove('-translate-x-full');\n        panel.classList.add('translate-x-0');\n        document.body.style.overflow = 'hidden';\n      }\n\n      function closeMenu() {\n        if (!drawer) return;\n        drawer.classList.remove('opacity-100', 'pointer-events-auto');\n        drawer.classList.add('opacity-0', 'pointer-events-none');\n        panel.classList.remove('translate-x-0');\n        panel.classList.add('-translate-x-full');\n        document.body.style.overflow = '';\n      }\n\n      if (toggleBtn) toggleBtn.addEventListener('click', openMenu);\n      if (closeBtn) closeBtn.addEventListener('click', closeMenu);\n      if (backdrop) backdrop.addEventListener('click', closeMenu);\n      navLinks.forEach(function(link) {\n        link.addEventListener('click', closeMenu);\n      });\n      document.addEventListener('keydown', function(e) {\n        if (e.key === 'Escape') closeMenu();\n      });\n    })();\n  </script>\n\n  <!-- 1. HERO SECTION: DAS ECHTE TOR MIT CINEMATISCHEM KEN-BURNS REINZOOM -->\n  <section class=\"relative min-h-[85vh] flex flex-col justify-end px-4 sm:px-6 lg:px-10 pb-12 pt-16\">\n    \n    <!-- Rounded Architectural Container with Zooming Tor Image -->\n    <div class=\"absolute inset-4 sm:inset-6 lg:inset-8 rounded-[32px] overflow-hidden bg-[#1C1B1A]\">\n      <img \n        src=\"https://bau-mueller.eu/wp-content/uploads/2025/08/Tor-Zimmerei-Mueller.jpeg\" \n        alt=\"Eingangstor Zimmerei Arthur Müller Colditz\" \n        class=\"w-full h-full object-cover animate-hero-tor brightness-[0.78] contrast-[1.06]\"\n      >\n      <!-- Subtle Ambient Dark Gradient Overlay for Typographic Contrast -->\n      <div class=\"absolute inset-0 bg-gradient-to-t from-black/85 via-black/35 to-black/25\"></div>\n      \n      <!-- Ambient \"Live Camera / Video\" Pill Badge -->\n      <div class=\"absolute top-6 left-6 z-20 flex items-center gap-2 px-3 py-1.5 rounded-full bg-black/40 backdrop-blur-md border border-white/15 text-white text-[11px] font-medium tracking-wide\">\n        <span class=\"w-2 h-2 rounded-full bg-[#E31936] animate-pulse\"></span>\n        <span>Geithainer Str. 32 · Colditz</span>\n      </div>\n    </div>\n\n    <!-- Hero Content Bottom Anchored (Somerville Style) -->\n    <div class=\"relative z-10 max-w-[1340px] mx-auto w-full px-4 sm:px-8\">\n      <div class=\"max-w-4xl\">\n        <span class=\"inline-block text-xs uppercase tracking-[0.2em] font-semibold text-[#FFFCF5]/80 mb-3\">\n          Meisterbetrieb in 4. Generation · Meisterhaft seit 1920\n        </span>\n        <h1 class=\"font-heading font-extrabold text-3xl sm:text-5xl lg:text-6xl xl:text-7xl text-[#FFFCF5] leading-[1.08] tracking-tight\">\n          Präziser Holzbau & solide Handwerkskunst.\n        </h1>\n      </div>\n\n      <!-- Hairline divider + subtitle like Somerville -->\n      <div class=\"mt-8 pt-6 border-t border-white/20 flex flex-col md:flex-row md:items-center justify-between gap-6\">\n        <p class=\"text-sm sm:text-base text-[#FFFCF5]/85 max-w-2xl font-normal leading-relaxed\">\n          Zimmerei, Abbund im eigenen Sägewerk, individuelle Massivholztreppen und anspruchsvoller Massivbau für Colditz, Grimma, Leipzig und ganz Sachsen.\n        </p>\n        <div class=\"flex items-center gap-3 shrink-0\">\n          <a href=\"#leistungen\" class=\"btn-pill-light\">\n            <span>Leistungen entdecken</span>\n            <svg class=\"w-3.5 h-3.5 text-[#1C1B1A]\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n              <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.5\" d=\"M19 9l-7 7-7-7\"/>\n            </svg>\n          </a>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <!-- 2. SERVICES SECTION (CREAM BACKGROUND, REAL PHOTO CARDS) -->\n  <section id=\"leistungen\" class=\"py-24 max-w-[1340px] mx-auto px-6\">\n    <div class=\"max-w-3xl mb-16\">\n      <h2 class=\"font-heading font-bold text-3xl sm:text-4xl lg:text-5xl text-[#1A1918] leading-[1.15]\">\n        Zimmerei, Holzbau, Maßtreppen und moderner Massivbau.\n      </h2>\n      <p class=\"mt-4 text-base text-[#6E6963] leading-relaxed\">\n        Alles aus einer Hand: Vom computergestützten Dachstuhl-Abbund über denkmalgerechte Sanierung bis zu eigenen Pellets aus Restholz.\n      </p>\n    </div>\n\n    <!-- 3 Core Service Photo Cards (Somerville Style with Floating + Badges & 100% Real Photos) -->\n    <div class=\"grid grid-cols-1 md:grid-cols-3 gap-8\">\n      \n      <!-- Card 1: Zimmerei & Holzbau (Echter Kirchendachstuhl Wildenhain) -->\n      <a href=\"#leistungen\" class=\"group block\">\n        <div class=\"relative aspect-[4/5] rounded-[24px] overflow-hidden bg-[#EAE5D9] mb-5\">\n          <img \n            src=\"https://bau-mueller.eu/wp-content/uploads/2022/04/Dachstuhl-Sanierung-Kirche-Wildenhain.jpeg\" \n            alt=\"Dachstuhlsanierung Kirche Wildenhain - Zimmerei Müller\" \n            class=\"w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105\"\n          >\n          <div class=\"action-circle-badge\">\n            <svg class=\"w-4 h-4 text-[#E31936]\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\">\n              <line x1=\"12\" y1=\"5\" x2=\"12\" y2=\"19\"></line>\n              <line x1=\"5\" y1=\"12\" x2=\"19\" y2=\"12\"></line>\n            </svg>\n          </div>\n        </div>\n        <h3 class=\"font-heading font-bold text-2xl text-[#1A1918] inline-block editorial-link-hover\">\n          Zimmerei & Holzbau\n        </h3>\n        <p class=\"mt-2 text-sm text-[#6E6963] leading-relaxed\">\n          Dachstühle, Gauben, Carports und Hallenkonstruktionen – millimetergenau vorgefertigt im eigenen Abbundzentrum.\n        </p>\n      </a>\n\n      <!-- Card 2: Treppen- & Möbelbau (Echte viertelgewendelte Wangentreppe Koltzschen) -->\n      <a href=\"#leistungen\" class=\"group block\">\n        <div class=\"relative aspect-[4/5] rounded-[24px] overflow-hidden bg-[#EAE5D9] mb-5\">\n          <img \n            src=\"https://bau-mueller.eu/wp-content/uploads/2022/04/Wangentreppe-viertelgewendelt-Koltzschen.jpeg\" \n            alt=\"Maßgefertigte Holztreppe Koltzschen - Zimmerei Müller\" \n            class=\"w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105\"\n          >\n          <div class=\"action-circle-badge\">\n            <svg class=\"w-4 h-4 text-[#E31936]\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\">\n              <line x1=\"12\" y1=\"5\" x2=\"12\" y2=\"19\"></line>\n              <line x1=\"5\" y1=\"12\" x2=\"19\" y2=\"12\"></line>\n            </svg>\n          </div>\n        </div>\n        <h3 class=\"font-heading font-bold text-2xl text-[#1A1918] inline-block editorial-link-hover\">\n          Treppen- & Möbelbau\n        </h3>\n        <p class=\"mt-2 text-sm text-[#6E6963] leading-relaxed\">\n          Individuelle Massivholztreppen, Wangentreppen und maßgefertigter Innenausbau mit edlen heimischen Hölzern.\n        </p>\n      </a>\n\n      <!-- Card 3: Massivbau & Denkmal (Echtes Sichtmauerwerk Röhrsdorf) -->\n      <a href=\"#leistungen\" class=\"group block\">\n        <div class=\"relative aspect-[4/5] rounded-[24px] overflow-hidden bg-[#EAE5D9] mb-5\">\n          <img \n            src=\"https://bau-mueller.eu/wp-content/uploads/2022/04/Sichtmauerwerk-Röhrsdorf.jpeg\" \n            alt=\"Sichtmauerwerk und Naturstein - Baugeschäft Müller\" \n            class=\"w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105\"\n          >\n          <div class=\"action-circle-badge\">\n            <svg class=\"w-4 h-4 text-[#E31936]\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\">\n              <line x1=\"12\" y1=\"5\" x2=\"12\" y2=\"19\"></line>\n              <line x1=\"5\" y1=\"12\" x2=\"19\" y2=\"12\"></line>\n            </svg>\n          </div>\n        </div>\n        <h3 class=\"font-heading font-bold text-2xl text-[#1A1918] inline-block editorial-link-hover\">\n          Massivbau & Denkmal\n        </h3>\n        <p class=\"mt-2 text-sm text-[#6E6963] leading-relaxed\">\n          Maurer- und Betonarbeiten, Fundamente sowie denkmalgerechte Fachwerksanierung mit historischem Fingerspitzengefühl.\n        </p>\n      </a>\n\n    </div>\n  </section>\n\n  <!-- 3. FLOATING DARK ARCHITECTURAL SLAB (SOMERVILLE USP SECTION: ECHTE WERKSTATT-FOTOS AUS DER ANLAGE) -->\n  <section id=\"werkstatt\" class=\"px-4 sm:px-6 lg:px-8 py-6\">\n    <div class=\"bg-charcoal text-cream rounded-[36px] px-8 sm:px-12 lg:px-16 py-20 lg:py-24 max-w-[1380px] mx-auto\">\n      \n      <!-- Top split content -->\n      <div class=\"flex flex-col lg:flex-row lg:items-end justify-between gap-8 pb-16 border-b border-white/10\">\n        <div class=\"max-w-2xl\">\n          <span class=\"text-xs font-semibold tracking-widest text-[#E31936] uppercase block mb-3\">\n            Echte Werkstattkapazitäten & Sägewerk\n          </span>\n          <h2 class=\"font-heading font-bold text-3xl sm:text-4xl lg:text-5xl text-[#FFFCF5] leading-tight\">\n            Vom rohen Stamm zum präzisen Bauwerk.\n          </h2>\n          <p class=\"mt-4 text-base text-muted-dark leading-relaxed\">\n            In unserer Werkstatt und dem eigenen Sägewerk in Colditz verarbeiten wir Stämme aller Holzarten – mit moderner Maschinentechnik und jahrzehntelanger Zimmerer-Erfahrung.\n          </p>\n        </div>\n        <div>\n          <a href=\"#ueber-uns\" class=\"btn-pill-light\">\n            <span>Über unsere Werkstatt</span>\n            <svg class=\"w-3.5 h-3.5 text-[#1C1B1A]\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n              <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.5\" d=\"M14 5l7 7m0 0l-7 7m7-7H3\"/>\n            </svg>\n          </a>\n        </div>\n      </div>\n\n      <!-- 3 Säulen mit den echten Werkstattbildern aus der Anlage (start4, start3, start2) -->\n      <div class=\"grid grid-cols-1 md:grid-cols-3 gap-10 pt-16\">\n        \n        <!-- Pillar 1: Sägewerk mit echtem Baumstammzuschnitt (start4.jpg) -->\n        <div>\n          <div class=\"aspect-[16/11] rounded-[20px] overflow-hidden bg-charcoal-card mb-6\">\n            <img \n              src=\"https://bau-mueller.eu/wp-content/uploads/2022/02/start4-768x1151.jpg\" \n              alt=\"Baumstamm-Zuschnitt im neuen Sägewerk Arthur Müller\" \n              class=\"w-full h-full object-cover object-center brightness-95 hover:scale-105 transition-transform duration-500\"\n            >\n          </div>\n          <span class=\"text-[11px] font-semibold text-[#E31936] uppercase tracking-wider block mb-1\">Neues Sägewerk</span>\n          <h3 class=\"font-heading font-bold text-xl text-[#FFFCF5] mb-2\">\n            Lohnschnitt bis 80 cm & 9 m\n          </h3>\n          <p class=\"text-sm text-muted-dark leading-relaxed\">\n            Unser Sägewerk schneidet Stämme aller Holzarten zu Balken, Brettern, Dielen, Latten und Kanthölzern – millimetergenau nach Kundenwunsch und mit Spezialschnitten.\n          </p>\n        </div>\n\n        <!-- Pillar 2: Tischsäge / Hobelbank (start3.jpg) -->\n        <div>\n          <div class=\"aspect-[16/11] rounded-[20px] overflow-hidden bg-charcoal-card mb-6\">\n            <img \n              src=\"https://bau-mueller.eu/wp-content/uploads/2022/02/start3-768x513.jpg\" \n              alt=\"Präzisions-Zuschnitt an der Sägemaschine\" \n              class=\"w-full h-full object-cover object-center brightness-95 hover:scale-105 transition-transform duration-500\"\n            >\n          </div>\n          <span class=\"text-[11px] font-semibold text-[#E31936] uppercase tracking-wider block mb-1\">Präzisions-Abbund</span>\n          <h3 class=\"font-heading font-bold text-xl text-[#FFFCF5] mb-2\">\n            Passgenauer Zuschnitt\n          </h3>\n          <p class=\"text-sm text-muted-dark leading-relaxed\">\n            Ausgereifte Holzbearbeitungsmaschinen garantieren exakte Winkel und saubere Verbindungen für Dachstühle, Carports und tragende Holzkonstruktionen.\n          </p>\n        </div>\n\n        <!-- Pillar 3: Werkstatt mit Holzbock vor Fenstern (start2.jpg) -->\n        <div>\n          <div class=\"aspect-[16/11] rounded-[20px] overflow-hidden bg-charcoal-card mb-6\">\n            <img \n              src=\"https://bau-mueller.eu/wp-content/uploads/2022/02/start2-768x513.jpg\" \n              alt=\"Werkstatt der Zimmerei Müller in Colditz\" \n              class=\"w-full h-full object-cover object-center brightness-95 hover:scale-105 transition-transform duration-500\"\n            >\n          </div>\n          <span class=\"text-[11px] font-semibold text-[#E31936] uppercase tracking-wider block mb-1\">Handwerkliche Fertigung</span>\n          <h3 class=\"font-heading font-bold text-xl text-[#FFFCF5] mb-2\">\n            Traditionelle Werkstatt\n          </h3>\n          <p class=\"text-sm text-muted-dark leading-relaxed\">\n            Hier entstehen maßgefertigte Holztreppen, individuelle Möbelstücke und Bauteile für die Altbausanierung. Echte Handarbeit mit Herzblut und Meisterbrief.\n          </p>\n        </div>\n\n      </div>\n\n    </div>\n  </section>\n\n  <!-- 4. EDITORIAL ASYMMETRIC SECTION (SOMERVILLE \"CLOSING THE LOOP\" PARALLEL MIT PELLETS & SÄGESPÄNEN) -->\n  <section id=\"nachhaltigkeit\" class=\"py-24 max-w-[1340px] mx-auto px-6\">\n    <div class=\"grid grid-cols-1 lg:grid-cols-12 gap-12 items-center\">\n      \n      <!-- Visual Side: Echtes Sägewerk-Detail -->\n      <div class=\"lg:col-span-6\">\n        <div class=\"relative aspect-[4/3] rounded-[28px] overflow-hidden bg-[#EAE5D9]\">\n          <img \n            src=\"https://bau-mueller.eu/wp-content/uploads/2022/02/start4-1025x1536.jpg\" \n            alt=\"Sägespäne und Holzverwertung ab Werk Colditz\" \n            class=\"w-full h-full object-cover object-center\"\n          >\n          <div class=\"absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent\"></div>\n          <div class=\"absolute bottom-6 left-6 text-white\">\n            <span class=\"text-xs uppercase tracking-widest text-white/80 block\">100 % Reststoffverwertung</span>\n            <p class=\"font-heading font-bold text-lg text-white mt-1\">Aus Holzspänen wird regionale Heizwärme</p>\n          </div>\n        </div>\n      </div>\n\n      <!-- Text Side: Asymmetrische Editorial Story -->\n      <div class=\"lg:col-span-6 lg:pl-6\">\n        <span class=\"text-xs font-semibold tracking-widest text-[#E31936] uppercase block mb-3\">\n          Verantwortung & Kreislaufwirtschaft\n        </span>\n        <h2 class=\"font-heading font-bold text-3xl sm:text-4xl text-[#1A1918] leading-[1.2]\">\n          Geschlossener Holzkreislauf direkt ab Werk Colditz.\n        </h2>\n        <p class=\"text-base text-[#4A4641] leading-relaxed mt-4 mb-4\">\n          Holz ist der wertvollste Baustoff unserer Natur. Deshalb lassen wir keinen Span ungenutzt: Alle Hobelspäne und Resthölzer aus unserer Zimmerei und dem Sägewerk werden direkt zu hochwertigen Kaminpellets (ENplus A1) und Holzbriketts verarbeitet.\n        </p>\n        <p class=\"text-sm text-[#6E6963] leading-relaxed mb-6\">\n          Kunden können Brennstoffe direkt bei uns in Colditz abholen oder bequem palettenweise anliefern lassen.\n        </p>\n        <a href=\"#kontakt\" class=\"btn-pill-dark\">\n          <span>Pellets & Briketts anfragen</span>\n          <svg class=\"w-3.5 h-3.5 text-[#E31936]\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n            <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.5\" d=\"M14 5l7 7m0 0l-7 7m7-7H3\"/>\n          </svg>\n        </a>\n      </div>\n\n    </div>\n  </section>\n\n  <!-- 5. PORTFOLIO SHOWCASE (SOMERVILLE ASYMMETRIC GALLERY GRID MIT ECHTEN PROJEKTEN) -->\n  <section id=\"projekte\" class=\"px-4 sm:px-6 lg:px-8 py-6\">\n    <div class=\"bg-charcoal text-cream rounded-[36px] px-8 sm:px-12 py-20 max-w-[1380px] mx-auto\">\n      \n      <div class=\"flex flex-col md:flex-row md:items-end justify-between gap-6 mb-14\">\n        <div>\n          <span class=\"text-xs font-semibold tracking-widest text-[#E31936] uppercase block mb-2\">\n            Referenzen & Handwerksbelege\n          </span>\n          <h2 class=\"font-heading font-bold text-3xl sm:text-4xl text-[#FFFCF5]\">\n            Ausgewählte Bauvorhaben & Holzbau-Projekte\n          </h2>\n        </div>\n        <a href=\"#projekte\" class=\"btn-pill-light\">\n          <span>Alle Referenzen ansehen</span>\n          <svg class=\"w-3.5 h-3.5 text-[#1C1B1A]\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n            <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.5\" d=\"M14 5l7 7m0 0l-7 7m7-7H3\"/>\n          </svg>\n        </a>\n      </div>\n\n      <!-- Asymmetric Grid of Project Cards -->\n      <div class=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6\">\n        \n        <!-- Project 1: Kirchendachstuhl Wildenhain -->\n        <div class=\"group relative rounded-[24px] overflow-hidden bg-charcoal-card aspect-[4/3] cursor-pointer\">\n          <img \n            src=\"https://bau-mueller.eu/wp-content/uploads/2022/04/Dachstuhl-Sanierung-Kirche-Wildenhain.jpeg\" \n            alt=\"Dachstuhlsanierung Kirche Wildenhain\" \n            class=\"w-full h-full object-cover transition-transform duration-700 group-hover:scale-105\"\n          >\n          <div class=\"absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent\"></div>\n          <div class=\"absolute bottom-6 left-6 right-6 flex items-end justify-between\">\n            <div>\n              <span class=\"text-xs text-[#FFFCF5]/70 font-medium\">Zimmerei · Wildenhain</span>\n              <h3 class=\"font-heading font-bold text-lg text-white mt-1\">Dachstuhlsanierung Kirche</h3>\n            </div>\n            <div class=\"w-10 h-10 rounded-full bg-white flex items-center justify-center text-[#E31936] shrink-0\">\n              <svg class=\"w-4 h-4\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n                <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.5\" d=\"M14 5l7 7m0 0l-7 7m7-7H3\"/>\n              </svg>\n            </div>\n          </div>\n        </div>\n\n        <!-- Project 2: Wangentreppe Koltzschen -->\n        <div class=\"group relative rounded-[24px] overflow-hidden bg-charcoal-card aspect-[4/3] cursor-pointer\">\n          <img \n            src=\"https://bau-mueller.eu/wp-content/uploads/2022/04/Wangentreppe-viertelgewendelt-Koltzschen.jpeg\" \n            alt=\"Massivholztreppe Koltzschen\" \n            class=\"w-full h-full object-cover transition-transform duration-700 group-hover:scale-105\"\n          >\n          <div class=\"absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent\"></div>\n          <div class=\"absolute bottom-6 left-6 right-6 flex items-end justify-between\">\n            <div>\n              <span class=\"text-xs text-[#FFFCF5]/70 font-medium\">Treppenbau · Koltzschen</span>\n              <h3 class=\"font-heading font-bold text-lg text-white mt-1\">Viertelgewendelte Wangentreppe</h3>\n            </div>\n            <div class=\"w-10 h-10 rounded-full bg-white flex items-center justify-center text-[#E31936] shrink-0\">\n              <svg class=\"w-4 h-4\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n                <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.5\" d=\"M14 5l7 7m0 0l-7 7m7-7H3\"/>\n              </svg>\n            </div>\n          </div>\n        </div>\n\n        <!-- Project 3: Kirchturmsanierung Zschirla -->\n        <div class=\"group relative rounded-[24px] overflow-hidden bg-charcoal-card aspect-[4/3] cursor-pointer\">\n          <img \n            src=\"https://bau-mueller.eu/wp-content/uploads/2022/04/Putzsanierung-Kirchturm-Zschirla.jpeg\" \n            alt=\"Putzsanierung Kirchturm Zschirla\" \n            class=\"w-full h-full object-cover transition-transform duration-700 group-hover:scale-105\"\n          >\n          <div class=\"absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent\"></div>\n          <div class=\"absolute bottom-6 left-6 right-6 flex items-end justify-between\">\n            <div>\n              <span class=\"text-xs text-[#FFFCF5]/70 font-medium\">Denkmal · Zschirla</span>\n              <h3 class=\"font-heading font-bold text-lg text-white mt-1\">Putz- & Turmsanierung</h3>\n            </div>\n            <div class=\"w-10 h-10 rounded-full bg-white flex items-center justify-center text-[#E31936] shrink-0\">\n              <svg class=\"w-4 h-4\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n                <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.5\" d=\"M14 5l7 7m0 0l-7 7m7-7H3\"/>\n              </svg>\n            </div>\n          </div>\n        </div>\n\n      </div>\n\n    </div>\n  </section>\n\n  <!-- 6. HERITAGE & ÜBER UNS (ECHTES HISTORISCHES ZIMMERER-FOTO UBERUNSSW.JPG) -->\n  <section id=\"ueber-uns\" class=\"py-24 max-w-[1340px] mx-auto px-6\">\n    <div class=\"grid grid-cols-1 lg:grid-cols-12 gap-12 items-center\">\n      \n      <div class=\"lg:col-span-5\">\n        <span class=\"text-xs font-semibold tracking-widest text-[#E31936] uppercase block mb-3\">\n          Familienbetrieb seit 1920\n        </span>\n        <h2 class=\"font-heading font-bold text-3xl sm:text-4xl text-[#1A1918] leading-tight mb-6\">\n          Vier Generationen Handwerksehre in Colditz.\n        </h2>\n        <p class=\"text-base text-[#4A4641] leading-relaxed mb-4\">\n          Gegründet vor über einem Jahrhundert, wird die Zimmerei & das Baugeschäft Arthur Müller heute von Dipl.-Ing. Tobias Müller in vierter Generation geführt.\n        </p>\n        <p class=\"text-sm text-[#6E6963] leading-relaxed mb-6\">\n          Wir vereinen den traditionellen Zimmererschlag und alte Holzverbindungstechniken mit modernster CAD-Planung und maschinellem Abbund im eigenen Sägewerk.\n        </p>\n        <a href=\"#kontakt\" class=\"btn-pill-dark\">\n          <span>Gespräch mit Tobias Müller vereinbaren</span>\n          <svg class=\"w-3.5 h-3.5 text-[#E31936]\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n            <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.5\" d=\"M14 5l7 7m0 0l-7 7m7-7H3\"/>\n          </svg>\n        </a>\n      </div>\n\n      <div class=\"lg:col-span-7\">\n        <div class=\"relative rounded-[28px] overflow-hidden bg-[#EAE5D9] aspect-[16/10]\">\n          <img \n            src=\"https://bau-mueller.eu/wp-content/uploads/2022/02/uberunssw.jpg\" \n            alt=\"Historisches Foto: Handwerker der Zimmerei Arthur Müller\" \n            class=\"w-full h-full object-cover grayscale contrast-110\"\n          >\n          <div class=\"absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent\"></div>\n          <div class=\"absolute bottom-6 left-6 right-6 text-white text-xs\">\n            <p class=\"font-medium text-white/90\">Zimmerer-Mannschaft vor dem Betrieb in Colditz · Handwerkstradition seit über 100 Jahren</p>\n          </div>\n        </div>\n      </div>\n\n    </div>\n  </section>\n\n  <!-- 7. FOOTER (SOMERVILLE STYLE ARCHITECTURAL SLAB) -->\n  <footer id=\"kontakt\" class=\"bg-charcoal text-cream pt-20 pb-12 rounded-t-[40px]\">\n    <div class=\"max-w-[1340px] mx-auto px-6 lg:px-10\">\n      \n      <!-- Big Bold CTA Headline -->\n      <div class=\"pb-16 border-b border-white/10 flex flex-col md:flex-row md:items-end justify-between gap-8\">\n        <div class=\"max-w-2xl\">\n          <span class=\"text-xs font-semibold tracking-widest text-[#E31936] uppercase block mb-3\">\n            Kontakt & Vorhaben besprechen\n          </span>\n          <h2 class=\"font-heading font-bold text-3xl sm:text-5xl text-[#FFFCF5] leading-tight\">\n            Bereit für Ihr nächstes Bauvorhaben? Sprechen Sie mit uns.\n          </h2>\n        </div>\n        <div>\n          <a href=\"tel:+493438143336\" class=\"btn-pill-light text-base\">\n            <span>034381-43336 anrufen</span>\n            <svg class=\"w-4 h-4 text-[#1C1B1A]\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n              <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.5\" d=\"M14 5l7 7m0 0l-7 7m7-7H3\"/>\n            </svg>\n          </a>\n        </div>\n      </div>\n\n      <!-- Navigation & Info Columns -->\n      <div class=\"grid grid-cols-1 md:grid-cols-4 gap-10 py-16 text-sm\">\n        <div>\n          <h4 class=\"font-heading font-bold text-white text-base mb-4 uppercase tracking-wider text-xs\">Standort</h4>\n          <p class=\"text-muted-dark leading-relaxed\">\n            Zimmerei & Baugeschäft Arthur Müller e.K.<br>\n            Geithainer Str. 32<br>\n            04680 Colditz<br>\n            Inhaber: Dipl.-Ing. Tobias Müller\n          </p>\n        </div>\n        <div>\n          <h4 class=\"font-heading font-bold text-white text-base mb-4 uppercase tracking-wider text-xs\">Gewerke</h4>\n          <ul class=\"space-y-2.5 text-muted-dark\">\n            <li><a href=\"#\" class=\"hover:text-white transition-colors\">Zimmerei & Holzbau</a></li>\n            <li><a href=\"#\" class=\"hover:text-white transition-colors\">Treppen- & Möbelbau</a></li>\n            <li><a href=\"#\" class=\"hover:text-white transition-colors\">Maurer- & Betonarbeiten</a></li>\n            <li><a href=\"#\" class=\"hover:text-white transition-colors\">Altbausanierung & Denkmal</a></li>\n            <li><a href=\"#\" class=\"hover:text-white transition-colors\">Pellets & Holzbriketts</a></li>\n          </ul>\n        </div>\n        <div>\n          <h4 class=\"font-heading font-bold text-white text-base mb-4 uppercase tracking-wider text-xs\">Öffnungszeiten</h4>\n          <p class=\"text-muted-dark leading-relaxed\">\n            Montag – Freitag: 08:00 – 15:30 Uhr<br>\n            Pellet-Verkauf & Abholung ab Werk.<br>\n            Telefon: 034381-43336\n          </p>\n        </div>\n        <div>\n          <h4 class=\"font-heading font-bold text-white text-base mb-4 uppercase tracking-wider text-xs\">Förderhinweis (SAB/EU)</h4>\n          <p class=\"text-[12px] text-muted-dark leading-relaxed\">\n            Gefördert durch die Europäische Union und den Freistaat Sachsen im Rahmen der regionalen Wirtschaftsförderung (EFRE / SAB).\n          </p>\n        </div>\n      </div>\n\n      <!-- Bottom Bar & Copyright -->\n      <div class=\"pt-8 border-t border-white/10 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-muted-dark\">\n        <p>© 2026 Arthur Müller e.K. · Meisterbetrieb seit 1920</p>\n        <div class=\"flex items-center gap-6\">\n          <a href=\"#\" class=\"hover:text-white transition-colors\">Impressum</a>\n          <a href=\"#\" class=\"hover:text-white transition-colors\">Datenschutz</a>\n          <a href=\"#\" class=\"hover:text-white transition-colors\">Cookie-Einstellungen</a>\n        </div>\n      </div>\n\n    </div>\n  </footer>\n</div>\n"
          }
        }
