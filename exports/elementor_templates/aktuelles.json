li><a href=\"/leistungen/\" class=\"hover:text-white transition-colors\">Maurer- & Betonarbeiten</a></li>\n            <li><a href=\"/leistungen/\" class=\"hover:text-white transition-colors\">Altbausanierung & Denkmal</a></li>\n            <li><a href=\"/leistungen/\" class=\"hover:text-white transition-colors\">Pellets & Holzbriketts</a></li>\n          </ul>\n        </div>\n        <div>\n          <h4 class=\"font-heading font-bold text-white text-base mb-4 uppercase tracking-wider text-xs\">Öffnungszeiten</h4>\n          <p class=\"text-muted-dark leading-relaxed\">\n            Montag – Freitag: 08:00 – 15:30 Uhr<br>\n            Pellet-Verkauf & Abholung ab Werk.<br>\n            Telefon: 034381-43336\n          </p>\n        </div>\n        <div>\n          <h4 class=\"font-heading font-bold text-white text-base mb-4 uppercase tracking-wider text-xs\">Aktuelles & Magazin</h4>\n          <ul class=\"space-y-2.5 text-muted-dark\">\n            <li><a href=\"/aktuelles/\" class=\"hover:text-white transition-colors\">Werkstatt & Sägewerk</a></li>\n            <li><a href=\"/aktuelles/\" class=\"hover:text-white transition-colors\">Pellet-Verfügbarkeit</a></li>\n            <li><a href=\"/werkstatt-der-zukunft-praezision-trifft-tradition/\" class=\"hover:text-white transition-colors\">SAB-Förderprojekt</a></li>\n          </ul>\n        </div>\n      </div>\n\n      <!-- Bottom Bar & Copyright -->\n      <div class=\"pt-8 border-t border-white/10 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-muted-dark\">\n        <p>© 2026 Arthur Müller e.K. · Meisterbetrieb seit 1920</p>\n        <div class=\"flex items-center gap-6\">\n          <a href=\"/impressum/\" class=\"hover:text-white transition-colors\">Impressum</a>\n          <a href=\"/datenschutz/\" class=\"hover:text-white transition-colors\">Datenschutz</a>\n        </div>\n      </div>\n\n    </div>\n  </footer>\n\n  <script>\n    // MOBILE MENU DRAWER TOGGLE\n    const toggleBtn = document.getElementById('menu-toggle-btn');\n    const drawer = document.getElementById('mobile-menu-drawer');\n    const backdrop = document.getElementById('mobile-menu-backdrop');\n    const panel = document.getElementById('mobile-menu-panel');\n    const closeBtn = document.getElementById('mobile-menu-close');\n    const navLinks = document.querySelectorAll('.mobile-nav-link');\n\n    function openMenu() {\n      drawer.classList.remove('opacity-0', 'pointer-events-none');\n      drawer.classList.add('opacity-100', 'pointer-events-auto');\n      panel.classList.remove('-translate-x-full');\n      panel.classList.add('translate-x-0');\n      toggleBtn.setAttribute('aria-expanded', 'true');\n      drawer.setAttribute('aria-hidden', 'false');\n      document.body.style.overflow = 'hidden';\n    }\n\n    function closeMenu() {\n      drawer.classList.remove('opacity-100', 'pointer-events-auto');\n      drawer.classList.add('opacity-0', 'pointer-events-none');\n      panel.classList.remove('translate-x-0');\n      panel.classList.add('-translate-x-full');\n      toggleBtn.setAttribute('aria-expanded', 'false');\n      drawer.setAttribute('aria-hidden', 'true');\n      document.body.style.overflow = '';\n    }\n\n    toggleBtn.addEventListener('click', openMenu);\n    closeBtn.addEventListener('click', closeMenu);\n    backdrop.addEventListener('click', closeMenu);\n    navLinks.forEach(link => link.addEventListener('click', closeMenu));\n    document.addEventListener('keydown', (e) => {\n      if (e.key === 'Escape' && drawer.getAttribute('aria-hidden') === 'false') {\n        closeMenu();\n      }\n    });\n\n    // CATEGORY FILTER PILLS\n    const filterButtons = document.querySelectorAll('.filter-pill');\n    const postCards = document.querySelectorAll('.post-card');\n\n    filterButtons.forEach(btn => {\n      btn.addEventListener('click', () => {\n        filterButtons.forEach(b => b.classList.remove('active'));\n        btn.classList.add('active');\n        const filter = btn.getAttribute('data-filter');\n\n        postCards.forEach(card => {\n          if (filter === 'all' || card.getAttribute('data-category') === filter) {\n            card.style.display = 'flex';\n          } else {\n            card.style.display = 'none';\n          }\n        });\n      });\n    });\n  </script>\n\n\n  <!-- FEEDBACK / VOTING POPUP (ERSCHEINT NACH 8 SEKUNDEN) -->\n  <aside id=\"feedback-voting-popup\" aria-label=\"Feedback zur neuen Website\" class=\"fixed bottom-6 right-6 z-50 max-w-sm w-[calc(100%-3rem)] sm:w-96 bg-[#1C1B1A]/95 text-[#F8F5EE] backdrop-blur-lg rounded-[24px] p-6 shadow-2xl border border-white/15 transform translate-y-20 opacity-0 pointer-events-none transition-all duration-500 ease-out\">\n    \n    <!-- Close Button -->\n    <button id=\"feedback-popup-close\" class=\"absolute top-4 right-4 w-7 h-7 rounded-full bg-white/10 hover:bg-white/20 flex items-center justify-center text-white/70 hover:text-white transition-colors focus:outline-none\" aria-label=\"Feedback-Fenster schließen\">\n      <svg class=\"w-3.5 h-3.5\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n        <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M6 18L18 6M6 6l12 12\"/>\n      </svg>\n    </button>\n\n    <!-- Initial State -->\n    <div id=\"voting-initial-state\">\n      <div class=\"flex items-center gap-2 mb-2\">\n        <span class=\"w-2 h-2 rounded-full bg-[#E31936] animate-pulse\"></span>\n        <span class=\"text-[11px] font-semibold tracking-wider uppercase text-[#E31936]\">Neuer Webauftritt</span>\n      </div>\n      <h3 class=\"font-heading font-bold text-lg text-white mb-1.5 leading-snug\">\n        Wie gefällt Ihnen unsere neue Website?\n      </h3>\n      <p class=\"text-xs text-[#A39E93] mb-4 leading-relaxed\">\n        Ihre Meinung zählt: Wie gefällt Ihnen das neue Design unseres Meisterbetriebs?\n      </p>\n\n      <div class=\"grid grid-cols-3 gap-2\">\n        <button class=\"vote-btn py-2.5 px-2 rounded-xl bg-white/10 hover:bg-[#E31936] text-white text-xs font-semibold flex flex-col items-center gap-1 transition-all\" data-vote=\"super\">\n          <span class=\"text-base\">😍</span>\n          <span>Begeistert</span>\n        </button>\n        <button class=\"vote-btn py-2.5 px-2 rounded-xl bg-white/10 hover:bg-white/20 text-white text-xs font-semibold flex flex-col items-center gap-1 transition-all\" data-vote=\"gut\">\n          <span class=\"text-base\">👍</span>\n          <span>Sehr gut</span>\n        </button>\n        <button class=\"vote-btn py-2.5 px-2 rounded-xl bg-white/10 hover:bg-white/20 text-white text-xs font-semibold flex flex-col items-center gap-1 transition-all\" data-vote=\"feedback\">\n          <span class=\"text-base\">💬</span>\n          <span>Geht so</span>\n        </button>\n      </div>\n    </div>\n\n    <!-- Thank You State -->\n    <div id=\"voting-thankyou-state\" class=\"hidden py-4 text-center\">\n      <span class=\"text-3xl block mb-2\">🪵✨</span>\n      <h4 class=\"font-heading font-bold text-base text-white mb-1\">Vielen Dank für Ihre Stimme!</h4>\n      <p class=\"text-xs text-[#A39E93]\">Ihr Feedback hilft uns, den Auftritt unseres Meisterbetriebs stetig zu verfeinern.</p>\n    </div>\n\n  </aside>\n\n  <script>\n    // FEEDBACK VOTING POPUP LOGIC (Trigger nach 8 Sekunden)\n    (function() {\n      const popup = document.getElementById('feedback-voting-popup');\n      if (!popup) return;\n      \n      // Prüfen ob bereits abgestimmt oder geschlossen\n      if (localStorage.getItem('mueller_website_voted') || sessionStorage.getItem('mueller_popup_dismissed')) {\n        return;\n      }\n\n      const closeBtn = document.getElementById('feedback-popup-close');\n      const initialState = document.getElementById('voting-initial-state');\n      const thankYouState = document.getElementById('voting-thankyou-state');\n      const voteBtns = document.querySelectorAll('.vote-btn');\n\n      function showPopup() {\n        popup.classList.remove('translate-y-20', 'opacity-0', 'pointer-events-none');\n        popup.classList.add('translate-y-0', 'opacity-100', 'pointer-events-auto');\n      }\n\n      function hidePopup() {\n        popup.classList.remove('translate-y-0', 'opacity-100', 'pointer-events-auto');\n        popup.classList.add('translate-y-20', 'opacity-0', 'pointer-events-none');\n      }\n\n      // Erscheint nach 8 Sekunden\n      setTimeout(showPopup, 8000);\n\n      if (closeBtn) {\n        closeBtn.addEventListener('click', function() {\n          hidePopup();\n          sessionStorage.setItem('mueller_popup_dismissed', 'true');\n        });\n      }\n\n      voteBtns.forEach(btn => {\n        btn.addEventListener('click', function() {\n          const vote = btn.getAttribute('data-vote');\n          localStorage.setItem('mueller_website_voted', vote);\n          \n          if (initialState && thankYouState) {\n            initialState.classList.add('hidden');\n            thankYouState.classList.remove('hidden');\n          }\n          \n          // Nach 3 Sekunden automatisch sanft ausblenden\n          setTimeout(hidePopup, 3000);\n        });\n      });\n    })();\n  </script>\n</div>\n"
          }
        }
