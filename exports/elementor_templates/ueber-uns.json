        {
          "id": "html_ueber-uns",
          "elType": "widget",
          "widgetType": "html",
          "settings": {
            "html": "<!-- SOMERVILLE ARCHITECTURAL CRAFT DESIGN: NEU – Über uns -->\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link href=\"https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Inter:wght@400;500;600&display=swap\" rel=\"stylesheet\">\n<script src=\"https://cdn.tailwindcss.com\"></script>\n<style>\nbody {\n      font-family: 'Inter', sans-serif;\n      background-color: #F8F5EE;\n      color: #1A1918;\n      -webkit-font-smoothing: antialiased;\n    }\n    h1, h2, h3, h4, .font-heading {\n      font-family: 'Plus Jakarta Sans', sans-serif;\n      letter-spacing: -0.028em;\n    }\n    .bg-cream { background-color: #F8F5EE; }\n    .bg-charcoal { background-color: #1C1B1A; }\n    .bg-charcoal-card { background-color: #262523; }\n    .text-charcoal { color: #1A1918; }\n    .text-cream { color: #FAF7F2; }\n    .text-muted-dark { color: #9C968F; }\n    .accent-red { color: #E31936; }\n\n    .btn-pill-dark {\n      background-color: #1C1B1A;\n      color: #FAF7F2;\n      border-radius: 9999px;\n      padding: 12px 26px;\n      font-size: 14px;\n      font-weight: 600;\n      display: inline-flex;\n      align-items: center;\n      gap: 10px;\n      transition: all 0.25s ease;\n    }\n    .btn-pill-dark:hover {\n      background-color: #2F2E2C;\n      transform: translateY(-1px);\n    }\n    .btn-pill-light {\n      background-color: #FAF7F2;\n      color: #1C1B1A;\n      border-radius: 9999px;\n      padding: 12px 26px;\n      font-size: 14px;\n      font-weight: 600;\n      display: inline-flex;\n      align-items: center;\n      gap: 10px;\n      transition: all 0.25s ease;\n    }\n    .btn-pill-light:hover {\n      background-color: #FFFFFF;\n      transform: translateY(-1px);\n    }\n</style>\n\n<div class=\"somerville-container w-full bg-[#F8F5EE] text-[#1A1918] antialiased\" style=\"font-family: 'Inter', sans-serif;\">\n<!-- TOP HEADER (MINIMALIST, ARCHITECTURAL SOMERVILLE) -->\n  <header class=\"sticky top-0 z-50 bg-[#F8F5EE]/95 backdrop-blur-md border-b border-[#E8E3D8] transition-all\">\n    <div class=\"max-w-[1400px] mx-auto px-4 sm:px-6 py-4 flex items-center justify-between\">\n      \n      <!-- Left: Mobile Menu Toggle Button & Desktop Nav -->\n      <div class=\"flex items-center gap-6 sm:gap-8\">\n        <button id=\"menu-toggle-btn\" class=\"flex items-center gap-2.5 text-xs font-semibold tracking-wider uppercase text-[#1A1918] hover:text-[#E31936] transition-colors focus:outline-none\" aria-label=\"Menü öffnen\">\n          <span class=\"w-5 flex flex-col gap-1\">\n            <span class=\"block w-5 h-0.5 bg-current transition-all\"></span>\n            <span class=\"block w-3.5 h-0.5 bg-current transition-all\"></span>\n          </span>\n          <span class=\"inline\">Menü</span>\n        </button>\n        <nav class=\"hidden lg:flex items-center gap-7 text-sm font-medium text-[#4A4641]\">\n          <a href=\"/leistungen/\" class=\"hover:text-[#1A1918] transition-colors\">Leistungen</a>\n          <a href=\"/#werkstatt\" class=\"hover:text-[#1A1918] transition-colors\">Werkstatt & Sägewerk</a>\n          <a href=\"/projects/\" class=\"hover:text-[#1A1918] transition-colors\">Referenzen</a>\n          <a href=\"/#nachhaltigkeit\" class=\"hover:text-[#1A1918] transition-colors flex items-center gap-1.5\">\n            Pellets <span class=\"text-[10px] font-bold px-1.5 py-0.5 rounded-full bg-[#E31936] text-white\">Öko</span>\n          </a>\n          <a href=\"/about/\" class=\"text-[#1A1918] font-bold border-b-2 border-[#1A1918] pb-0.5\">Über uns</a>\n        </nav>\n      </div>\n\n      <!-- Center: Architectural Brand Identity -->\n      <div class=\"text-center\">\n        <a href=\"/\" class=\"inline-block\">\n          <span class=\"block font-heading font-extrabold text-lg sm:text-xl md:text-2xl tracking-tight text-[#1A1918] uppercase\">\n            Arthur Müller\n          </span>\n          <span class=\"block text-[9px] sm:text-[10px] tracking-[0.25em] uppercase text-[#7A756E] font-medium mt-0.5\">\n            Zimmerei & Baugeschäft · Seit 1920\n          </span>\n        </a>\n      </div>\n\n      <!-- Right: Direct Phone CTA & Project Button -->\n      <div class=\"flex items-center gap-3 sm:gap-4\">\n        <a href=\"tel:+493438143336\" class=\"hidden sm:inline-block text-xs font-semibold text-[#4A4641] hover:text-[#1A1918] transition-colors\">\n          034381 43336\n        </a>\n        <a href=\"#kontakt\" class=\"btn-pill-dark text-xs sm:text-sm\">\n          <span>Projekt anfragen</span>\n          <svg class=\"w-3.5 h-3.5 text-[#E31936]\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n            <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.5\" d=\"M14 5l7 7m0 0l-7 7m7-7H3\"/>\n          </svg>\n        </a>\n      </div>\n    </div>\n  </header>\n\n  <!-- MOBILE / OFF-CANVAS NAVIGATION DRAWER -->\n  <div id=\"mobile-menu-drawer\" class=\"fixed inset-0 z-[100] transition-opacity duration-300 opacity-0 pointer-events-none\" aria-hidden=\"true\">\n    <div id=\"mobile-menu-backdrop\" class=\"absolute inset-0 bg-[#1C1B1A]/80 backdrop-blur-md\"></div>\n    <div id=\"mobile-menu-panel\" class=\"absolute top-0 left-0 bottom-0 w-full max-w-sm sm:max-w-md bg-[#1C1B1A] text-[#F8F5EE] shadow-2xl flex flex-col justify-between p-6 sm:p-8 transform -translate-x-full transition-transform duration-300 ease-out border-r border-white/10 overflow-y-auto\">\n      <div>\n        <div class=\"flex items-center justify-between pb-6 border-b border-white/10\">\n          <div>\n            <span class=\"block font-heading font-extrabold text-lg tracking-tight uppercase text-white\">\n              Arthur Müller\n            </span>\n            <span class=\"block text-[10px] tracking-[0.2em] uppercase text-[#A39E93] mt-0.5 font-medium\">\n              Zimmerei & Baugeschäft · 1920\n            </span>\n          </div>\n          <button id=\"mobile-menu-close\" class=\"w-10 h-10 rounded-full bg-white/10 hover:bg-white/20 flex items-center justify-center text-white transition-colors focus:outline-none\" aria-label=\"Menü schließen\">\n            <svg class=\"w-5 h-5\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n              <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M6 18L18 6M6 6l12 12\"/>\n            </svg>\n          </button>\n        </div>\n\n        <nav class=\"mt-6 flex flex-col gap-2\">\n          <a href=\"/\" class=\"mobile-nav-link text-base sm:text-lg font-semibold text-white/90 hover:text-white py-2.5 flex items-center justify-between border-b border-white/5 transition-colors\">\n            <span>Startseite</span>\n            <span class=\"text-xs text-[#E31936]\">01</span>\n          </a>\n          <a href=\"/leistungen/\" class=\"mobile-nav-link text-base sm:text-lg font-semibold text-white/90 hover:text-white py-2.5 flex items-center justify-between border-b border-white/5 transition-colors\">\n            <span>Leistungen & Handwerk</span>\n            <span class=\"text-xs text-[#E31936]\">02</span>\n          </a>\n          <a href=\"/#werkstatt\" class=\"mobile-nav-link text-base sm:text-lg font-semibold text-white/90 hover:text-white py-2.5 flex items-center justify-between border-b border-white/5 transition-colors\">\n            <span>Werkstatt & Sägewerk</span>\n            <span class=\"text-xs text-[#E31936]\">03</span>\n          </a>\n          <a href=\"/projects/\" class=\"mobile-nav-link text-base sm:text-lg font-semibold text-white/90 hover:text-white py-2.5 flex items-center justify-between border-b border-white/5 transition-colors\">\n            <span>Referenzen & Bauten</span>\n            <span class=\"text-xs text-[#E31936]\">04</span>\n          </a>\n          <a href=\"/aktuelles/\" class=\"mobile-nav-link text-base sm:text-lg font-semibold text-white/90 hover:text-white py-2.5 flex items-center justify-between border-b border-white/5 transition-colors\"><span>Aktuelles & Magazin</span><span class=\"text-xs text-[#E31936]\">04</span></a>\n          <a href=\"/about/\" class=\"mobile-nav-link text-base sm:text-lg font-semibold text-white/90 hover:text-white py-2.5 flex items-center justify-between border-b border-white/5 transition-colors\">\n            <span>Über uns (4. Generation)</span>\n            <span class=\"text-xs text-[#E31936]\">05</span>\n          </a>\n          <a href=\"/#nachhaltigkeit\" class=\"mobile-nav-link text-base sm:text-lg font-semibold text-white/90 hover:text-white py-2.5 flex items-center justify-between border-b border-white/5 transition-colors\">\n            <span class=\"flex items-center gap-2\">\n              Pellet- & Holzbriketts\n              <span class=\"text-[10px] font-bold px-2 py-0.5 rounded-full bg-[#E31936] text-white\">Öko</span>\n            </span>\n            <span class=\"text-xs text-[#E31936]\">06</span>\n          </a>\n        </nav>\n      </div>\n\n      <div class=\"pt-6 border-t border-white/10 space-y-4 mt-6\">\n        <a href=\"tel:+493438143336\" class=\"w-full py-3 px-4 rounded-full bg-white/10 hover:bg-white/15 text-white flex items-center justify-center gap-2 text-sm font-semibold transition-colors\">\n          <svg class=\"w-4 h-4 text-[#E31936]\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n            <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z\"/>\n          </svg>\n          <span>034381 43336</span>\n        </a>\n        <a href=\"#kontakt\" class=\"btn-pill-light w-full justify-center text-sm py-3 mobile-nav-link\">\n          <span>Projekt anfragen</span>\n          <svg class=\"w-4 h-4 text-[#1C1B1A]\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n            <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.5\" d=\"M14 5l7 7m0 0l-7 7m7-7H3\"/>\n          </svg>\n        </a>\n        <div class=\"text-[11px] text-center text-[#A39E93] leading-relaxed\">\n          Geithainer Str. 32 · 04680 Colditz<br>\n          Mo–Fr: 08:00 – 15:30 Uhr\n        </div>\n      </div>\n    </div>\n  </div>\n\n  <script>\n    (function() {\n      var toggleBtn = document.getElementById('menu-toggle-btn');\n      var drawer = document.getElementById('mobile-menu-drawer');\n      var panel = document.getElementById('mobile-menu-panel');\n      var backdrop = document.getElementById('mobile-menu-backdrop');\n      var closeBtn = document.getElementById('mobile-menu-close');\n      var navLinks = document.querySelectorAll('.mobile-nav-link');\n\n      function openMenu() {\n        if (!drawer) return;\n        drawer.classList.remove('opacity-0', 'pointer-events-none');\n        drawer.classList.add('opacity-100', 'pointer-events-auto');\n        panel.classList.remove('-translate-x-full');\n        panel.classList.add('translate-x-0');\n        document.body.style.overflow = 'hidden';\n      }\n\n      function closeMenu() {\n        if (!drawer) return;\n        drawer.classList.remove('opacity-100', 'pointer-events-auto');\n        drawer.classList.add('opacity-0', 'pointer-events-none');\n        panel.classList.remove('translate-x-0');\n        panel.classList.add('-translate-x-full');\n        document.body.style.overflow = '';\n      }\n\n      if (toggleBtn) toggleBtn.addEventListener('click', openMenu);\n      if (closeBtn) closeBtn.addEventListener('click', closeMenu);\n      if (backdrop) backdrop.addEventListener('click', closeMenu);\n      navLinks.forEach(function(link) {\n        link.addEventListener('click', closeMenu);\n      });\n      document.addEventListener('keydown', function(e) {\n        if (e.key === 'Escape') closeMenu();\n      });\n    })();\n  </script>\n\n  <!-- HERO SECTION: 100 JAHRE MEISTERHANDWERK MIT ECHTEM HISTORISCHEM FOTO -->\n  <section class=\"py-20 px-6 max-w-[1340px] mx-auto border-b border-[#E8E3D8]\">\n    <div class=\"grid grid-cols-1 lg:grid-cols-12 gap-12 items-center\">\n      <div class=\"lg:col-span-7\">\n        <span class=\"text-xs uppercase tracking-[0.2em] font-semibold text-[#E31936] block mb-3\">\n          Tradition seit 1920 · 4. Generation\n        </span>\n        <h1 class=\"font-heading font-extrabold text-4xl sm:text-6xl text-[#1A1918] leading-[1.1] tracking-tight\">\n          Handwerkliche Beständigkeit über vier Generationen.\n        </h1>\n        <p class=\"mt-6 text-lg text-[#6E6963] max-w-xl leading-relaxed\">\n          Seit über einem Jahrhundert steht der Name Arthur Müller in Colditz für meisterhafte Bau- und Zimmermannsarbeit. Wir verbinden das traditionsreiche Zimmerer-Brauchtum mit fundiertem Ingenieurwissen und modernster Fertigungstechnik.\n        </p>\n      </div>\n\n      <div class=\"lg:col-span-5\">\n        <div class=\"relative rounded-[28px] overflow-hidden bg-[#EAE5D9] shadow-xl\">\n          <img \n            src=\"https://bau-mueller.eu/wp-content/uploads/2022/02/uberunssw.jpg\" \n            alt=\"Historische Zimmerer-Mannschaft Arthur Müller Colditz\" \n            class=\"w-full h-full object-cover grayscale contrast-110\"\n          >\n          <div class=\"absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent\"></div>\n          <div class=\"absolute bottom-5 left-5 right-5 text-white text-xs\">\n            <p class=\"font-semibold\">Historische Aufnahme · Zimmerei Arthur Müller Colditz</p>\n          </div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <!-- CHRONIK: 1 JAHRHUNDERT IN 4 STATIONEN (SOMERVILLE ASYMMETRISCH) -->\n  <section class=\"py-24 max-w-[1340px] mx-auto px-6\">\n    <div class=\"max-w-2xl mb-16\">\n      <span class=\"text-xs font-semibold tracking-widest text-[#E31936] uppercase block mb-2\">Historie & Wurzeln</span>\n      <h2 class=\"font-heading font-bold text-3xl sm:text-5xl text-[#1A1918] leading-tight\">\n        Vom Handwerksbetrieb zur modernen Holzbau-Manufaktur.\n      </h2>\n    </div>\n\n    <div class=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8\">\n      \n      <!-- Station 1920 -->\n      <div class=\"p-8 rounded-[24px] bg-[#F2EDE2] flex flex-col justify-between\">\n        <div>\n          <span class=\"font-heading font-extrabold text-4xl text-[#E31936] block mb-3\">1920</span>\n          <h3 class=\"font-heading font-bold text-xl text-[#1A1918] mb-2\">Die Gründung</h3>\n          <p class=\"text-sm text-[#6E6963] leading-relaxed\">\n            Baumeister Arthur Müller gründet das Unternehmen in Colditz. Mit Herzblut entstehen die ersten regionalen Wohnhäuser, Scheunen und Dachtragwerke.\n          </p>\n        </div>\n        <span class=\"text-[11px] font-semibold uppercase tracking-wider text-[#8A857E] mt-6 block\">1. Generation</span>\n      </div>\n\n      <!-- Station 1952 -->\n      <div class=\"p-8 rounded-[24px] bg-[#F2EDE2] flex flex-col justify-between\">\n        <div>\n          <span class=\"font-heading font-extrabold text-4xl text-[#E31936] block mb-3\">1952</span>\n          <h3 class=\"font-heading font-bold text-xl text-[#1A1918] mb-2\">Wiederaufbau</h3>\n          <p class=\"text-sm text-[#6E6963] leading-relaxed\">\n            Die 2. Generation übernimmt in herausfordernden Nachkriegszeiten und erweitert den Betrieb gezielt um spezialisierte Holzbau- und Zimmereikapazitäten.\n          </p>\n        </div>\n        <span class=\"text-[11px] font-semibold uppercase tracking-wider text-[#8A857E] mt-6 block\">2. Generation</span>\n      </div>\n\n      <!-- Station 1996 -->\n      <div class=\"p-8 rounded-[24px] bg-[#F2EDE2] flex flex-col justify-between\">\n        <div>\n          <span class=\"font-heading font-extrabold text-4xl text-[#E31936] block mb-3\">1996</span>\n          <h3 class=\"font-heading font-bold text-xl text-[#1A1918] mb-2\">Neuer Standort</h3>\n          <p class=\"text-sm text-[#6E6963] leading-relaxed\">\n            Verlagerung und Ausbau des heutigen Betriebsgeländes an der Geithainer Straße 32. Spezialisierung auf denkmalgerechte Sanierung und anspruchsvollen Treppenbau.\n          </p>\n        </div>\n        <span class=\"text-[11px] font-semibold uppercase tracking-wider text-[#8A857E] mt-6 block\">3. Generation</span>\n      </div>\n\n      <!-- Station Heute -->\n      <div class=\"p-8 rounded-[24px] bg-[#1C1B1A] text-white flex flex-col justify-between\">\n        <div>\n          <span class=\"font-heading font-extrabold text-4xl text-[#E31936] block mb-3\">Heute</span>\n          <h3 class=\"font-heading font-bold text-xl text-white mb-2\">Dipl.-Ing. Tobias Müller</h3>\n          <p class=\"text-sm text-[#9C968F] leading-relaxed\">\n            Einführung computergestützter Abbundtechnik, Neubau des Sägewerks und geschlossener Verwertungskreislauf für Pellets. Meisterbetrieb in 4. Generation.\n          </p>\n        </div>\n        <span class=\"text-[11px] font-semibold uppercase tracking-wider text-[#E31936] mt-6 block\">4. Generation</span>\n      </div>\n\n    </div>\n  </section>\n\n  <!-- INHABER STATEMENT SLAB (CHARCOAL) -->\n  <section class=\"px-4 sm:px-6 lg:px-8 py-6\">\n    <div class=\"bg-charcoal text-cream rounded-[36px] px-8 sm:px-14 py-20 max-w-[1380px] mx-auto\">\n      <div class=\"grid grid-cols-1 lg:grid-cols-12 gap-12 items-center\">\n        \n        <div class=\"lg:col-span-8\">\n          <span class=\"text-xs font-semibold tracking-widest text-[#E31936] uppercase block mb-4\">\n            Philosophie & Haltung\n          </span>\n          <blockquote class=\"font-heading font-bold text-2xl sm:text-4xl text-[#FFFCF5] leading-snug\">\n            „Ein Bauwerk ist mehr als Holz und Stein – es ist ein Lebensraum für Jahrzehnte. Als Bauingenieur und Zimmerer stehe ich persönlich für solide Planung und ehrliches Handwerk ohne Ausreden.“\n          </blockquote>\n          <div class=\"mt-8 flex items-center gap-4\">\n            <div>\n              <p class=\"font-heading font-bold text-lg text-white\">Dipl.-Ing. (FH) Tobias Müller</p>\n              <p class=\"text-xs text-muted-dark uppercase tracking-wider\">Inhaber & Zimmerermeister · 4. Generation</p>\n            </div>\n          </div>\n        </div>\n\n        <div class=\"lg:col-span-4 lg:border-l lg:border-white/15 lg:pl-10 space-y-6 text-sm text-muted-dark\">\n          <div>\n            <h4 class=\"font-heading font-bold text-white text-base mb-1\">Ingenieurwissen & Statik</h4>\n            <p>Berechnungen und Vorfertigung erfolgen mit höchster ingenieurmäßiger Sorgfalt.</p>\n          </div>\n          <div>\n            <h4 class=\"font-heading font-bold text-white text-base mb-1\">Echte Baustellennähe</h4>\n            <p>Der Inhaber berät Sie persönlich und begleitet die Umsetzung direkt vor Ort.</p>\n          </div>\n          <div>\n            <h4 class=\"font-heading font-bold text-white text-base mb-1\">Regionale Verbundenheit</h4>\n            <p>Verlässlicher Arbeitgeber und Handwerksmeister fest verwurzelt in Sachsen.</p>\n          </div>\n        </div>\n\n      </div>\n    </div>\n  </section>\n\n  <!-- WERKSTATT & SÄGEWERK EINBLICK (100% ECHTE FOTOS: START2, START3, START4) -->\n  <section class=\"py-24 max-w-[1340px] mx-auto px-6\">\n    <div class=\"max-w-2xl mb-14\">\n      <span class=\"text-xs font-semibold tracking-widest text-[#E31936] uppercase block mb-2\">Fertigung & Maschinenpark</span>\n      <h2 class=\"font-heading font-bold text-3xl sm:text-4xl text-[#1A1918]\">\n        Einblicke in Werkstatt & Sägewerk Colditz\n      </h2>\n      <p class=\"text-[#6E6963] text-base mt-3\">\n        In unserer Werkstatt an der Geithainer Straße 32 entstehen Präzisionsteile fernab industrieller Massenware.\n      </p>\n    </div>\n\n    <div class=\"grid grid-cols-1 md:grid-cols-3 gap-8\">\n      \n      <div>\n        <div class=\"aspect-[4/3] rounded-[24px] overflow-hidden bg-[#EAE5D9] mb-4\">\n          <img \n            src=\"https://bau-mueller.eu/wp-content/uploads/2022/02/start4-768x1151.jpg\" \n            alt=\"Sägewerk Baumstammzuschnitt\" \n            class=\"w-full h-full object-cover hover:scale-105 transition-transform duration-500\"\n          >\n        </div>\n        <h3 class=\"font-heading font-bold text-xl text-[#1A1918]\">Sägewerk & Lohnschnitt</h3>\n        <p class=\"text-sm text-[#6E6963] mt-1\">Zuschnitt von Stämmen bis 80 cm Durchmesser für Bauherren und Waldbesitzer.</p>\n      </div>\n\n      <div>\n        <div class=\"aspect-[4/3] rounded-[24px] overflow-hidden bg-[#EAE5D9] mb-4\">\n          <img \n            src=\"https://bau-mueller.eu/wp-content/uploads/2022/02/start3-768x513.jpg\" \n            alt=\"Tischkreissäge Werkstatt\" \n            class=\"w-full h-full object-cover hover:scale-105 transition-transform duration-500\"\n          >\n        </div>\n        <h3 class=\"font-heading font-bold text-xl text-[#1A1918]\">Moderne Sägemaschinen</h3>\n        <p class=\"text-sm text-[#6E6963] mt-1\">Ausgereifte Technik für millimetergenaue Winkel, Nuten und Zapfenverbindungen.</p>\n      </div>\n\n      <div>\n        <div class=\"aspect-[4/3] rounded-[24px] overflow-hidden bg-[#EAE5D9] mb-4\">\n          <img \n            src=\"https://bau-mueller.eu/wp-content/uploads/2022/02/start2-768x513.jpg\" \n            alt=\"Traditionelle Werkstatt\" \n            class=\"w-full h-full object-cover hover:scale-105 transition-transform duration-500\"\n          >\n        </div>\n        <h3 class=\"font-heading font-bold text-xl text-[#1A1918]\">Meisterwerkstatt</h3>\n        <p class=\"text-sm text-[#6E6963] mt-1\">Sorgfältige Handarbeit für Treppenwangen, Geländer und Restaurierungsarbeiten.</p>\n      </div>\n\n  